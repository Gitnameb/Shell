+      if ((candidateEdges & WLR_EDGE_TOP) != 0) {
+        distance = std::min(distance, std::abs(y - box.y));
+      }
+      if ((candidateEdges & WLR_EDGE_BOTTOM) != 0) {
+        distance = std::min(distance, std::abs(y - (box.y + box.height)));
+      }
+      if (distance < bestDistance) {
+        best = candidate;
+        bestEdges = candidateEdges;
