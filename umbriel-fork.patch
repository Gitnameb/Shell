+
+namespace umbriel {
+
+  namespace {
+    constexpr int kCardWidth = 46;
+    constexpr int kRowHeight = 32;
+    constexpr int kPadding = 5;
+    constexpr int kRowGap = 2;
+    constexpr int kMargin = 8;
+    constexpr int kOffsetY = 26;
+    constexpr int kRadius = 13;
+    constexpr int kRowRadius = 8;
+    constexpr int kMaxRows = 9;
+  } // namespace
+
+  MoveMenu::MoveMenu(Server& server, wlr_scene_tree* parent) : m_server(server), m_parent(parent) {}
+
+  MoveMenu::~MoveMenu() { hide(); }
+
+  void MoveMenu::show(View* view, double anchorX, double anchorY) {
+    if (view == nullptr) {
+      hide();
+      return;
+    }
+    Workspace* workspace = view->workspace();
+    WorkspaceGroup* group = workspace != nullptr ? workspace->group() : nullptr;
+    // Una ventana del scratchpad no tiene escritorio propio; el selector usa
+    // el grupo de su salida, que es donde puede aterrizar.
+    if (group == nullptr) {
+      Output* output = view->currentOutput();
+      group = output != nullptr ? output->workspaceGroup() : nullptr;
+    }
+    if (group == nullptr) {
+      hide();
+      return;
+    }
+    const size_t count = std::min<size_t>(group->workspaceCount(), kMaxRows);
+    if (count == 0) {
+      hide();
+      return;
+    }
+
+    hide();
+    m_view = view;
+    m_group = group;
+    m_count = count;
+    const size_t current = workspace != nullptr
+        ? workspace->index()
+        : (group->active() != nullptr ? group->active()->index() : 0);
+    m_current = std::min(current, count - 1);
+    m_hoverRow = -1;
+    m_cardWidth = kCardWidth;
+    m_padding = kPadding;
+    m_rowHeight = kRowHeight;
+    m_rowGap = kRowGap;
+    m_cardHeight = kPadding * 2 + kRowHeight * static_cast<int>(count) + kRowGap * (static_cast<int>(count) - 1);
+
+    Output* output = view->currentOutput();
+    if (output == nullptr) {
+      output = m_server.outputFromWlr(m_server.preferredOutput());
+    }
+    wlr_box outputBox{};
+    if (output != nullptr) {
+      wlr_output_layout_get_box(m_server.outputLayout(), output->wlr(), &outputBox);
+    }
+    if (outputBox.width <= 0 || outputBox.height <= 0) {
+      outputBox = {.x = 0, .y = 0, .width = 1920, .height = 1080};
+    }
+
+    const double desiredX = anchorX - m_cardWidth / 2.0;
+    const double desiredY = anchorY + kOffsetY;
+    m_cardX = std::round(std::clamp(
+        desiredX, static_cast<double>(outputBox.x + kMargin),
+        static_cast<double>(outputBox.x + outputBox.width - m_cardWidth - kMargin)
+    ));
+    m_cardY = std::round(std::clamp(
+        desiredY, static_cast<double>(outputBox.y + kMargin),
+        static_cast<double>(outputBox.y + outputBox.height - m_cardHeight - kMargin)
+    ));
+
+    render();
+  }
+
+  void MoveMenu::hide() {
+    if (m_tree != nullptr) {
+      m_shadow.reset();
+      wlr_scene_node_destroy(&m_tree->node);
+      m_tree = nullptr;
+    }
+    m_view = nullptr;
+    m_group = nullptr;
+    m_count = 0;
+    m_current = 0;
+    m_hoverRow = -1;
+    m_currentRow = nullptr;
+    m_hoverRowRect = nullptr;
+  }
+
+  void MoveMenu::forgetView(const View* view) {
+    if (m_view == view) {
+      hide();
+    }
+  }
+
+  bool MoveMenu::contains(double x, double y) const {
+    return x >= m_cardX && x < m_cardX + m_cardWidth && y >= m_cardY && y < m_cardY + m_cardHeight;
+  }
+
+  int MoveMenu::rowAt(double x, double y) const {
+    if (m_tree == nullptr || !contains(x, y)) {
+      return -1;
+    }
+    const double localX = x - m_cardX - m_padding;
+    const double localY = y - m_cardY - m_padding;
+    if (localX < 0.0 || localX >= m_cardWidth - 2.0 * m_padding || localY < 0.0) {
+      return -1;
+    }
+    const int stride = m_rowHeight + m_rowGap;
+    const int row = static_cast<int>(localY) / stride;
+    if (row < 0 || static_cast<size_t>(row) >= m_count) {
+      return -1;
+    }
+    if (static_cast<int>(localY) % stride >= m_rowHeight) {
+      return -1;
+    }
+    return row;
+  }
+
+  void MoveMenu::updateHover(double x, double y) {
+    setHoverRow(rowAt(x, y));
+  }
+
+  void MoveMenu::setHoverRow(int row) {
+    if (m_hoverRow == row) {
+      return;
+    }
+    m_hoverRow = row;
+    if (m_hoverRowRect == nullptr) {
+      return;
+    }
+    // El escritorio actual ya tiene su propio resaltado.
+    if (row < 0 || static_cast<size_t>(row) == m_current) {
+      wlr_scene_node_set_enabled(&m_hoverRowRect->node, false);
+      return;
+    }
+    wlr_scene_node_set_position(
+        &m_hoverRowRect->node, m_padding, m_padding + row * (m_rowHeight + m_rowGap)
+    );
+    wlr_scene_node_set_enabled(&m_hoverRowRect->node, true);
+  }
+
+  bool MoveMenu::handlePress(double x, double y, uint32_t button) {
+    if (m_tree == nullptr) {
+      return false;
+    }
+    if (button != BTN_LEFT) {
+      hide();
+      return true;
+    }
+    const int row = rowAt(x, y);
+    if (row < 0) {
+      hide();
+      return true;
+    }
+    choose(static_cast<size_t>(row));
+    return true;
+  }
+
+  bool MoveMenu::handleKey(uint32_t keysym) {
+    if (m_tree == nullptr) {
+      return false;
+    }
+    if (keysym == XKB_KEY_Escape) {
+      hide();
+      return true;
+    }
+    if (keysym >= XKB_KEY_1 && keysym <= XKB_KEY_9) {
+      choose(static_cast<size_t>(keysym - XKB_KEY_1));
+      return true;
+    }
+    if (keysym >= XKB_KEY_KP_1 && keysym <= XKB_KEY_KP_9) {
+      choose(static_cast<size_t>(keysym - XKB_KEY_KP_1));
+      return true;
+    }
+    // El menú es modal mientras está abierto: una tecla suelta no debe
+    // escribir en la ventana que quedó debajo.
+    return true;
+  }
+
+  void MoveMenu::choose(size_t index) {
+    View* view = m_view;
+    WorkspaceGroup* group = m_group;
+    const size_t current = m_current;
+    hide();
+    if (view == nullptr || group == nullptr || index >= kMaxRows || index == current) {
+      return;
+    }
+    // Como el selector del shell: la ventana se va al destino y el asiento se
+    // queda donde estaba.
+    (void)moveViewToWorkspaceAt(m_server, *view, *group, index, false);
+  }
+
+  void MoveMenu::render() {
+    if (m_view == nullptr || m_count == 0) {
+      return;
+    }
+    Output* output = m_view->currentOutput();
+    if (output == nullptr) {
+      output = m_server.outputFromWlr(m_server.preferredOutput());
+    }
+    const double scale = output != nullptr ? std::max(1.0, std::ceil(static_cast<double>(output->wlr()->scale))) : 1.0;
+
+    wlr_scene_node_raise_to_top(&m_parent->node);
+    m_tree = wlr_scene_tree_create(m_parent);
+    if (m_tree == nullptr) {
+      return;
+    }
+    wlr_scene_node_set_position(&m_tree->node, static_cast<int>(m_cardX), static_cast<int>(m_cardY));
+    m_shadow.update(m_tree, m_cardWidth, m_cardHeight, 1, kRadius);
+
+    const auto& colors = config().colors;
+    float borderColor[4]{};
+    float backgroundColor[4]{};
+    float currentColor[4]{};
+    float hoverColor[4]{};
+    premultiplied(borderColor, colors.border.focused, 0.45F);
+    premultiplied(backgroundColor, colors.background, 0.97F);
+    premultiplied(currentColor, colors.accentPrimary, 0.16F);
+    premultiplied(hoverColor, colors.textPrimary, 0.07F);
+
+    wlr_scene_rect* border = wlr_scene_rect_create(m_tree, m_cardWidth, m_cardHeight, borderColor);
+    if (border != nullptr) {
+      wlr_scene_rect_set_corner_radius(border, kRadius);
+      border->accepts_input = false;
+    }
+    wlr_scene_rect* panel =
+        wlr_scene_rect_create(m_tree, m_cardWidth - 2, m_cardHeight - 2, backgroundColor);
+    if (panel != nullptr) {
+      wlr_scene_node_set_position(&panel->node, 1, 1);
+      wlr_scene_rect_set_corner_radius(panel, kRadius - 1);
+      panel->accepts_input = false;
+    }
+
+    const int rowWidth = m_cardWidth - 2 * m_padding;
+    m_currentRow = wlr_scene_rect_create(m_tree, rowWidth, m_rowHeight, currentColor);
+    if (m_currentRow != nullptr) {
+      wlr_scene_rect_set_corner_radius(m_currentRow, kRowRadius);
+      m_currentRow->accepts_input = false;
+      wlr_scene_node_set_position(
+          &m_currentRow->node, m_padding, m_padding + static_cast<int>(m_current) * (m_rowHeight + m_rowGap)
+      );
+    }
+    m_hoverRowRect = wlr_scene_rect_create(m_tree, rowWidth, m_rowHeight, hoverColor);
+    if (m_hoverRowRect != nullptr) {
+      wlr_scene_rect_set_corner_radius(m_hoverRowRect, kRowRadius);
+      m_hoverRowRect->accepts_input = false;
+      wlr_scene_node_set_enabled(&m_hoverRowRect->node, false);
+    }
+
+    // Un buffer por número: Pango devuelve el ancho natural y así el dígito
+    // queda centrado en la celda sin depender de una fuente monoespaciada.
+    for (size_t index = 0; index < m_count; ++index) {
+      const bool current = index == m_current;
+      const std::string markup = std::format(
+          "<span foreground='{}' weight='bold'>{}</span>",
+          rgbaHex(current ? colors.accentPrimary : colors.textPrimary), index + 1
+      );
+      TextBufferResult rendered = renderTextBuffer({
+          .markup = markup,
+          .font = "sans 11",
+          .maxWidth = rowWidth,
+          .padding = 0,
+          .scale = scale,
+          .bgR = 0.0,
+          .bgG = 0.0,
+          .bgB = 0.0,
+          .bgA = 0.0,
+      });
+      if (rendered.buffer == nullptr) {
+        continue;
+      }
+      wlr_scene_buffer* node = wlr_scene_buffer_create(m_tree, rendered.buffer);
+      wlr_buffer_drop(rendered.buffer);
+      if (node == nullptr) {
+        continue;
+      }
+      node->point_accepts_input = [](wlr_scene_buffer*, double*, double*) -> bool { return false; };
+      wlr_scene_buffer_set_dest_size(node, rendered.logicalWidth, rendered.logicalHeight);
+      const int x = m_padding + (rowWidth - rendered.logicalWidth) / 2;
+      const int y = m_padding + static_cast<int>(index) * (m_rowHeight + m_rowGap)
+          + (m_rowHeight - rendered.logicalHeight) / 2;
+      wlr_scene_node_set_position(&node->node, x, y);
+    }
+  }
+
+} // namespace umbriel
diff --git a/src/scene/move_menu.h b/src/scene/move_menu.h
new file mode 100644
index 00000000..81756f52
--- /dev/null
+++ b/src/scene/move_menu.h
@@ -0,0 +1,74 @@
+#pragma once
+
+#include "scene/surface_shadow.h"
+
+#include <cstddef>
+#include <cstdint>
+
+struct wlr_scene_rect;
+struct wlr_scene_tree;
+
+namespace umbriel {
+
+  class Server;
+  class View;
+  class WorkspaceGroup;
+
+  // Selector 1–9 del botón «Mover» de la barra de título. Vive en Umbriel,
+  // como el resto de la decoración: una tarjeta estrecha junto al puntero con
+  // el escritorio actual resaltado. El teclado y el ratón los atienden
+  // Keyboard y Cursor; esta clase solo dibuja y resuelve el destino.
+  class MoveMenu {
+  public:
+    MoveMenu(Server& server, wlr_scene_tree* parent);
+    ~MoveMenu();
+
+    MoveMenu(const MoveMenu&) = delete;
+    MoveMenu& operator=(const MoveMenu&) = delete;
+
+    void show(View* view, double anchorX, double anchorY);
+    void hide();
+    bool visible() const { return m_tree != nullptr; }
+    View* view() const { return m_view; }
+    // Una ventana destruida no puede dejar el menú apuntando a memoria libre.
+    void forgetView(const View* view);
+
+    bool contains(double x, double y) const;
+    int rowAt(double x, double y) const;
+    void updateHover(double x, double y);
+    // Cualquier pulsación se consume mientras el menú está abierto: dentro
+    // elige un escritorio y fuera solo lo cierra.
+    bool handlePress(double x, double y, uint32_t button);
+    // Escape cierra; 1–9 eligen; el resto no llega a la ventana de debajo.
+    bool handleKey(uint32_t keysym);
+
+  private:
+    void render();
+    void choose(size_t index);
+    void setHoverRow(int row);
+
+    Server& m_server;
+    wlr_scene_tree* m_parent;
+    wlr_scene_tree* m_tree = nullptr;
+    SurfaceShadow m_shadow;
+
+    View* m_view = nullptr;
+    WorkspaceGroup* m_group = nullptr;
+    size_t m_count = 0;
+    size_t m_current = 0;
+    int m_hoverRow = -1;
+
+    // Coordenadas globales de la tarjeta.
+    double m_cardX = 0.0;
+    double m_cardY = 0.0;
+    int m_cardWidth = 46;
+    int m_cardHeight = 0;
+    int m_padding = 5;
+    int m_rowHeight = 32;
+    int m_rowGap = 2;
+
+    wlr_scene_rect* m_currentRow = nullptr;
+    wlr_scene_rect* m_hoverRowRect = nullptr;
+  };
+
+} // namespace umbriel
diff --git a/src/scene/native_handles.cpp b/src/scene/native_handles.cpp
new file mode 100644
index 00000000..8e5c2f4a
--- /dev/null
+++ b/src/scene/native_handles.cpp
@@ -0,0 +1,254 @@
+#include "scene/native_handles.h"
+
+#include "config/config.h"
+#include "scene/color.h"
+
+// clang-format off
+#include <algorithm>
+#include <cmath>
+#include "wlr.h"
+// clang-format on
+
+namespace umbriel {
+
+  namespace {
+    constexpr int kDotSize = 8;
+    constexpr int kDotInset = 6;
+    constexpr int kBandWidth = 14;
+    constexpr int kCoreWidth = 2;
+    constexpr float kBandAlpha = 0.10F;
+    constexpr float kCoreAlpha = 0.42F;
+    constexpr float kHoverBandAlpha = 0.18F;
+    constexpr float kHoverCoreAlpha = 0.90F;
+    constexpr float kDotAlpha = 0.90F;
+
+    wlr_scene_rect* makeRect(wlr_scene_tree* tree) {
+      float color[4]{};
+      wlr_scene_rect* rect = wlr_scene_rect_create(tree, 1, 1, color);
+      if (rect != nullptr) {
+        rect->accepts_input = false;
+        wlr_scene_node_set_enabled(&rect->node, false);
+      }
+      return rect;
+    }
+
+    // Tramo visible de un borde compartido, con el mismo margen que el diseño:
+    // 7 % de cada extremo, acotado entre 6 y 46 px.
+    bool spanBounds(double start, double end, int extent, int& first, int& last) {
+      if (extent <= 0 || end <= start) {
+        return false;
+      }
+      const int rawStart = std::clamp(static_cast<int>(std::lround(start * extent)), 0, extent);
+      const int rawEnd = std::clamp(static_cast<int>(std::lround(end * extent)), 0, extent);
+      const int span = rawEnd - rawStart;
+      if (span < 48) {
+        return false;
+      }
+      const int inset = std::clamp(static_cast<int>(std::lround(span * 0.07)), 6, 46);
+      first = rawStart + inset;
+      last = rawEnd - inset;
+      return last - first >= 12;
+    }
+  } // namespace
+
+  NativeHandles::NativeHandles(wlr_scene_tree* parent) : m_parent(parent) {}
+
+  NativeHandles::~NativeHandles() {
+    if (m_tree != nullptr) {
+      wlr_scene_node_destroy(&m_tree->node);
+      m_tree = nullptr;
+    }
+  }
+
+  void NativeHandles::ensureScene() {
+    if (m_tree != nullptr) {
+      return;
+    }
+    m_tree = wlr_scene_tree_create(m_parent);
+    for (wlr_scene_rect*& dot : m_dots) {
+      dot = makeRect(m_tree);
+      if (dot != nullptr) {
+        wlr_scene_rect_set_corner_radius(dot, kDotSize / 2);
+      }
+    }
+    m_rightBand = makeRect(m_tree);
+    m_rightCore = makeRect(m_tree);
+    m_bottomBand = makeRect(m_tree);
+    m_bottomCore = makeRect(m_tree);
+    if (m_rightBand != nullptr) {
+      wlr_scene_rect_set_corner_radius(m_rightBand, kBandWidth / 2);
+    }
+    if (m_bottomBand != nullptr) {
+      wlr_scene_rect_set_corner_radius(m_bottomBand, kBandWidth / 2);
+    }
+    if (m_rightCore != nullptr) {
+      wlr_scene_rect_set_corner_radius(m_rightCore, kCoreWidth / 2);
+    }
+    if (m_bottomCore != nullptr) {
+      wlr_scene_rect_set_corner_radius(m_bottomCore, kCoreWidth / 2);
+    }
+    wlr_scene_node_set_enabled(&m_tree->node, false);
+  }
+
+  void NativeHandles::setActive(bool active) {
+    if (m_active == active) {
+      return;
+    }
+    m_active = active;
+    apply();
+  }
+
+  void NativeHandles::setFocused(bool focused) {
+    if (m_focused == focused) {
+      return;
+    }
+    m_focused = focused;
+    apply();
+  }
+
+  void NativeHandles::setDividerHover(bool right, bool bottom) {
+    if (m_hoverRight == right && m_hoverBottom == bottom) {
+      return;
+    }
+    m_hoverRight = right;
+    m_hoverBottom = bottom;
+    apply();
+  }
+
+  void NativeHandles::setTileEdges(
+      bool right, double rightStart, double rightEnd, bool bottom, double bottomStart, double bottomEnd
+  ) {
+    m_right = right;
+    m_rightStart = rightStart;
+    m_rightEnd = rightEnd;
+    m_bottom = bottom;
+    m_bottomStart = bottomStart;
+    m_bottomEnd = bottomEnd;
+    apply();
+  }
+
+  void NativeHandles::layout(
+      int contentWidth, int contentHeight, int gap, bool tiled, bool dotsAllowed, bool suppressed
+  ) {
+    m_width = contentWidth;
+    m_height = contentHeight;
+    m_gap = gap > 0 ? gap : config().layoutGap();
+    m_tiled = tiled;
+    m_dotsAllowed = dotsAllowed;
+    m_suppressed = suppressed;
+    apply();
+  }
+
+  void NativeHandles::apply() {
+    if (!m_active || m_suppressed || m_width <= 0 || m_height <= 0) {
+      if (m_visible) {
+        wlr_scene_node_set_enabled(&m_tree->node, false);
+        m_visible = false;
+      }
+      return;
+    }
+
+    ensureScene();
+    if (m_tree == nullptr) {
+      return;
+    }
+
+    const bool showDots = !m_tiled && m_focused && m_dotsAllowed
+        && m_width >= 2 * (kDotInset + kDotSize) && m_height >= 2 * (kDotInset + kDotSize);
+    int rightFirst = 0;
+    int rightLast = 0;
+    int bottomFirst = 0;
+    int bottomLast = 0;
+    const bool showRight = m_tiled && m_right && spanBounds(m_rightStart, m_rightEnd, m_height, rightFirst, rightLast);
+    const bool showBottom = m_tiled && m_bottom
+        && spanBounds(m_bottomStart, m_bottomEnd, m_width, bottomFirst, bottomLast);
+
+    const bool visible = showDots || showRight || showBottom;
+    if (!visible) {
+      if (m_visible) {
+        wlr_scene_node_set_enabled(&m_tree->node, false);
+        m_visible = false;
+      }
+      return;
+    }
+
+    if (!m_visible) {
+      wlr_scene_node_set_enabled(&m_tree->node, true);
+      wlr_scene_node_raise_to_top(&m_tree->node);
+      m_visible = true;
+    }
+
+    // El acento sigue al tema sin reiniciar. Los nodos son pocos y esto solo
+    // se ejecuta mientras los indicadores están visibles.
+    const auto& accent = config().colors.accentPrimary;
+    float bandColor[4]{};
+    float coreColor[4]{};
+    float dotColor[4]{};
+    premultiplied(bandColor, accent, kBandAlpha);
+    premultiplied(coreColor, accent, kCoreAlpha);
+    premultiplied(dotColor, accent, kDotAlpha);
+    float hoverBandColor[4]{};
+    float hoverCoreColor[4]{};
+    premultiplied(hoverBandColor, accent, kHoverBandAlpha);
+    premultiplied(hoverCoreColor, accent, kHoverCoreAlpha);
+
+    for (size_t i = 0; i < m_dots.size(); ++i) {
+      wlr_scene_rect* dot = m_dots[i];
+      if (dot == nullptr) {
+        continue;
+      }
+      wlr_scene_node_set_enabled(&dot->node, showDots);
+      if (!showDots) {
+        continue;
+      }
+      const int x = (i % 2 == 0) ? kDotInset : m_width - kDotInset - kDotSize;
+      const int y = (i < 2) ? kDotInset : m_height - kDotInset - kDotSize;
+      wlr_scene_node_set_position(&dot->node, x, y);
+      wlr_scene_rect_set_size(dot, kDotSize, kDotSize);
+      wlr_scene_rect_set_color(dot, dotColor);
+    }
+
+    setDividerVisible();
+    if (showRight) {
+      placeDivider(m_rightBand, m_rightCore, true, m_width + m_gap / 2, rightFirst, rightLast);
+      wlr_scene_rect_set_color(m_rightBand, m_hoverRight ? hoverBandColor : bandColor);
+      wlr_scene_rect_set_color(m_rightCore, m_hoverRight ? hoverCoreColor : coreColor);
+    }
+    if (showBottom) {
+      placeDivider(m_bottomBand, m_bottomCore, false, m_height + m_gap / 2, bottomFirst, bottomLast);
+      wlr_scene_rect_set_color(m_bottomBand, m_hoverBottom ? hoverBandColor : bandColor);
+      wlr_scene_rect_set_color(m_bottomCore, m_hoverBottom ? hoverCoreColor : coreColor);
+    }
+  }
+
+  void NativeHandles::setDividerVisible() {
+    for (wlr_scene_rect* rect : {m_rightBand, m_rightCore, m_bottomBand, m_bottomCore}) {
+      if (rect != nullptr) {
+        wlr_scene_node_set_enabled(&rect->node, false);
+      }
+    }
+  }
+
+  void NativeHandles::placeDivider(
+      wlr_scene_rect* band, wlr_scene_rect* core, bool vertical, int position, int first, int last
+  ) {
+    const int length = last - first;
+    if (band == nullptr || core == nullptr || length <= 0) {
+      return;
+    }
+    if (vertical) {
+      wlr_scene_node_set_position(&band->node, position - kBandWidth / 2, first);
+      wlr_scene_rect_set_size(band, kBandWidth, length);
+      wlr_scene_node_set_position(&core->node, position - kCoreWidth / 2, first);
+      wlr_scene_rect_set_size(core, kCoreWidth, length);
+    } else {
+      wlr_scene_node_set_position(&band->node, first, position - kBandWidth / 2);
+      wlr_scene_rect_set_size(band, length, kBandWidth);
+      wlr_scene_node_set_position(&core->node, first, position - kCoreWidth / 2);
+      wlr_scene_rect_set_size(core, length, kCoreWidth);
+    }
+    wlr_scene_node_set_enabled(&band->node, true);
+    wlr_scene_node_set_enabled(&core->node, true);
+  }
+
+} // namespace umbriel
diff --git a/src/scene/native_handles.h b/src/scene/native_handles.h
new file mode 100644
index 00000000..6aa20119
--- /dev/null
+++ b/src/scene/native_handles.h
@@ -0,0 +1,78 @@
+#pragma once
+
+extern "C" {
+#include <wlr/util/box.h>
+}
+
+#include <array>
+
+struct wlr_scene_rect;
+struct wlr_scene_tree;
+
+namespace umbriel {
+
+  // Indicadores nativos del modo ventanas. Viven dentro del árbol de la
+  // ventana, así que se mueven y redimensionan con ella en el mismo frame, sin
+  // el retraso de una capa externa:
+  //
+  //  · cuatro puntos en las esquinas de la ventana flotante enfocada;
+  //  · una línea en cada borde compartido entre mosaicos.
+  //
+  // Solo se dibujan mientras se mantiene Mod (el mismo estado que muestra las
+  // barras de título superpuestas) y nunca sobre la vista general ni el bloqueo.
+  class NativeHandles {
+  public:
+    explicit NativeHandles(wlr_scene_tree* parent);
+    ~NativeHandles();
+    NativeHandles(const NativeHandles&) = delete;
+    NativeHandles& operator=(const NativeHandles&) = delete;
+
+    void setActive(bool active);
+    void setFocused(bool focused);
+    // Tramos normalizados (0..1) del borde propio que comparte con un vecino.
+    // `right` dibuja el divisor vertical y `bottom` el horizontal.
+    void setTileEdges(
+        bool right, double rightStart, double rightEnd, bool bottom, double bottomStart, double bottomEnd
+    );
+    // Resalta el divisor que está bajo el puntero. Son dos ejes porque una
+    // ventana puede compartir borde derecho e inferior a la vez.
+    void setDividerHover(bool right, bool bottom);
+    // `gap` es el hueco total entre cajas de contenido (incluye los bordes).
+    // `dotsAllowed` deja fuera las flotantes maximizadas y las de pantalla
+    // completa; `suppressed` oculta todo (vista general, bloqueo, minimizada).
+    void layout(int contentWidth, int contentHeight, int gap, bool tiled, bool dotsAllowed, bool suppressed);
+
+  private:
+    void ensureScene();
+    void apply();
+    void placeDivider(wlr_scene_rect* band, wlr_scene_rect* core, bool vertical, int position, int first, int last);
+    void setDividerVisible();
+
+    wlr_scene_tree* m_parent = nullptr;
+    wlr_scene_tree* m_tree = nullptr;
+    std::array<wlr_scene_rect*, 4> m_dots{};
+    wlr_scene_rect* m_rightBand = nullptr;
+    wlr_scene_rect* m_rightCore = nullptr;
+    wlr_scene_rect* m_bottomBand = nullptr;
+    wlr_scene_rect* m_bottomCore = nullptr;
+
+    bool m_active = false;
+    bool m_focused = false;
+    bool m_tiled = false;
+    bool m_dotsAllowed = false;
+    bool m_suppressed = false;
+    bool m_visible = false;
+    bool m_right = false;
+    bool m_bottom = false;
+    bool m_hoverRight = false;
+    bool m_hoverBottom = false;
+    double m_rightStart = 0.0;
+    double m_rightEnd = 0.0;
+    double m_bottomStart = 0.0;
+    double m_bottomEnd = 0.0;
+    int m_width = 0;
+    int m_height = 0;
+    int m_gap = 0;
+  };
+
+} // namespace umbriel
