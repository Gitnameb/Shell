+                                                                          : nullptr;
+    }
+    if (workspace == nullptr) {
+      return nullptr;
+    }
+    View* best = nullptr;
+    uint32_t bestEdges = 0;
+    double bestDistance = std::numeric_limits<double>::infinity();
+    const auto consider = [&](View* candidate) {
+      if (candidate == nullptr || !candidate->tiled() || !candidate->mapped() || candidate->attached()
+          || candidate->tabHidden() || candidate->scheduledFullscreen() || candidate->currentFullscreen()) {
+        return;
