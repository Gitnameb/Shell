+UMBRIEL_TEST(stackingFloatingDefaultsLoadAndResolveWorkspaceOverrides) {
+  const TempConfig file;
+  ConfigStore& store = umbriel::configStore();
+  store.setRootPath(file.path(), true);
+
+  file.write("[layout.stacking]\n");
+  CHECK(store.reload().success);
+  CHECK_EQ(store.config().layout.stacking.defaultWidthFraction, 0.6);
+  CHECK_EQ(store.config().layout.stacking.defaultHeightFraction, 0.6);
+  CHECK_EQ(store.config().layout.stacking.cascadeStep, 0);
+
+  file.write(R"(
+[layout.stacking]
+default_width_fraction = 0.75
+default_height_fraction = 0.55
+cascade_step = 48
+[[workspace]]
+name = "small"
+layout.stacking.default_width_fraction = 0.5
+layout.stacking.cascade_step = 64
+)");
+  CHECK(store.reload().success);
+  CHECK_EQ(store.config().layout.stacking.defaultWidthFraction, 0.75);
+  CHECK_EQ(store.config().layout.stacking.defaultHeightFraction, 0.55);
+  CHECK_EQ(store.config().layout.stacking.cascadeStep, 48);
+  const auto resolve = [&store](std::string_view name) {
+    return umbriel::resolveWorkspaceLayout(
+        store.config(), {.connector = "DP-1", .make = {}, .model = {}, .serial = {}}, name, 0
+    );
+  };
+  CHECK_EQ(resolve("small").stacking.defaultWidthFraction, 0.5);
+  CHECK_EQ(resolve("small").stacking.defaultHeightFraction, 0.55);
+  CHECK_EQ(resolve("small").stacking.cascadeStep, 64);
+
+  file.write("[layout.stacking]\ndefault_width_fraction = 0.05\ncascade_step = 500\n");
+  CHECK(store.reload().success);
+  CHECK_EQ(store.config().layout.stacking.defaultWidthFraction, 0.1);
+  CHECK_EQ(store.config().layout.stacking.cascadeStep, 200);
+  CHECK(containsDiagnostic(store, "layout.stacking.default_width_fraction = 0.05 out of range, clamped to 0.1"));
+  CHECK(containsDiagnostic(store, "layout.stacking.cascade_step = 500 out of range, clamped to 200"));
+}
