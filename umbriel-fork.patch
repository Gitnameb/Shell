+        || m_layoutMode == LayoutMode::Stacking
+        || m_switchingLayoutMode) {
+      return false;
+    }
+    const auto saved = std::ranges::find_if(
+        m_rememberedViewSlots, [view](const RememberedViewSlot& slot) { return slot.view == view; }
+    );
+    if (saved == m_rememberedViewSlots.end()
+        || saved->mode != m_layoutMode
+        || saved->capture.snapshot == nullptr) {
+      return false;
