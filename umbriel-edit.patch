+    // is still tiled here and nothing else joined. A new or moved window would
+    // make the old tree wrong, so in that case the normal insertion wins.
+    std::vector<View*> current;
+    for (View* candidate : m_views) {
+      if (candidate != view && m_layout->columnOf(candidate) >= 0) {
+        current.push_back(candidate);
+      }
+    }
+    std::vector<LayoutMember> members;
+    members.reserve(current.size() + 1);
+    for (const LayoutMember& member : saved->capture.members) {
+      View* memberView = member.view;
+      if (memberView == nullptr) {
+        return false;
