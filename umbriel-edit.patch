+  nlohmann::json IpcCommands::movedWindowMenu(Server& server, IpcArgs args) {
+    View* view = nullptr;
+    if (args.empty()) {
+      view = umbriel::focusedWindow(server);
+    } else {
+      for (const auto& candidate : server.views()) {
