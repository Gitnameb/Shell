+    // workspace view list stay untouched. If the snapshot cannot be rebuilt,
+    // put the windows back and let the caller insert normally.
+    for (View* memberView : current) {
+      m_layout->removeView(memberView);
+    }
+    if (!m_layout->restoreState(*saved->capture.snapshot, members)) {
+      for (View* memberView : current) {
+        m_layout->insertView(memberView, static_cast<int>(m_layout->columns().size()));
+      }
+      return false;
+    }
+    // Keep the record as the window's last known tile; a later float replaces
+    // it before it can be used again. It also keeps the scrolling snapshot
+    // alive for any deferred viewport restore.
+    return true;
+  }
