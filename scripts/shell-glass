#!/bin/sh
# Cristal del shell: reglas de desenfoque por capa y radio global.
#
# Uso:
#   shell-glass ensure               añade o actualiza las layer_rule
#   shell-glass mode wallpaper       desenfoca solo el fondo de pantalla
#   shell-glass mode behind          desenfoca el contenido que hay detrás
#   shell-glass blur <0-100>         cambia el radio global de Umbriel
#   shell-glass status               muestra el estado actual
#
# El shell dibuja superficies transparentes; Umbriel solo las desenfoca si una
# [[layer_rule]] coincide con su namespace. El radio es global: se aplica
# también al blur de las ventanas. Todas las escrituras pasan por
# shell-config-set, el escritor único de config.toml.
set -eu

cfg="${UMBRIEL_CONFIG:-$HOME/.config/umbriel/config.toml}"
start_marker='# shell-glass: inicio'
end_marker='# shell-glass: fin'
# Debe quedar por debajo del alpha mínimo del cristal (0.10 con transparencia
# 90 %) y por encima de 0, para que la máscara descarte las esquinas
# transparentes sin apagar el desenfoque del panel.
ignore_alpha=0.04
wstart_marker='# shell-windows: inicio'
wend_marker='# shell-windows: fin'
# Tono del desenfoque. Se puede afinar sin recompilar en este archivo:
#   ~/.config/shell/glass-blur.conf
blur_conf="${SHELL_GLASS_BLUR_CONF:-$HOME/.config/shell/glass-blur.conf}"
DARK_BRIGHTNESS=0.72
DARK_CONTRAST=0.92
DARK_SATURATION=1.06
LIGHT_BRIGHTNESS=1.08
LIGHT_CONTRAST=0.95
LIGHT_SATURATION=1.02
BLUR_PASSES=3

usage() {
    cat <<'EOF'
Configura el cristal del shell en Umbriel.

Uso:
  shell-glass ensure
  shell-glass mode wallpaper|behind
  shell-glass blur <0-100>
  shell-glass windows <0-90> <0|1>
  shell-glass tone dark|light
  shell-glass status

  wallpaper  desenfoca solo el fondo de pantalla (como el mockup)
  behind     desenfoca las ventanas y el contenido que hay detrás
  windows    transparencia de las ventanas y desenfoque de lo que hay
             detrás; 0 las deja opacas
  tone       aplica el brillo, contraste y saturación del modo oscuro o
             claro desde ~/.config/shell/glass-blur.conf
EOF
}

find_config_set() {
    if [ -n "${SHELL_CONFIG_SET:-}" ] && [ -x "$SHELL_CONFIG_SET" ]; then
        printf '%s\n' "$SHELL_CONFIG_SET"
        return 0
    fi
    if command -v shell-config-set >/dev/null 2>&1; then
        command -v shell-config-set
        return 0
    fi
    here=$(cd "$(dirname "$0")" && pwd)
    for candidate in "$here/shell-config-set" \
            "$here/../install/bin/shell-config-set"; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

reload() {
    umbriel msg config-reload >/dev/null 2>&1 || true
}

# Lee solo las claves conocidas de glass-blur.conf, sin ejecutar el archivo.
load_blur_conf() {
    [ -f "$blur_conf" ] || return 0
    while IFS='=' read -r key value; do
        value=$(printf '%s' "$value" | sed 's/[[:space:]]*#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//')
        case "$key" in
            DARK_BRIGHTNESS|DARK_CONTRAST|DARK_SATURATION|LIGHT_BRIGHTNESS|LIGHT_CONTRAST|LIGHT_SATURATION|BLUR_PASSES) ;;
            *) continue ;;
        esac
        case "$value" in
            ''|*[!0-9.]*) continue ;;
        esac
        eval "$key=\$value"
    done <"$blur_conf"
}

clamp_real() {
    awk -v v="$1" -v lo="$2" -v hi="$3" 'BEGIN {
        if (v + 0 < lo) v = lo;
        if (v + 0 > hi) v = hi;
        printf "%.3f", v
    }'
}

clamp_int() {
    awk -v v="$1" -v lo="$2" -v hi="$3" 'BEGIN {
        v = int(v + 0);
        if (v < lo) v = lo;
        if (v > hi) v = hi;
        printf "%d", v
    }'
}

# El bloque se genera entero para poder sustituirlo sin tocar el resto del
# archivo. El primer argumento es true (solo fondo) o false (contenido real).
layer_block() {
    optimized=${1:-true}
    cat <<EOF
# shell-glass: inicio
# Cristal del shell. Umbriel desenfoca las superficies transparentes. Con
# blur_optimized = true muestrea la caché del fondo de pantalla y los paneles
# nunca desenfocan las ventanas; con false desenfoca el contenido real.
# blur_ignore_alpha descarta los píxeles transparentes de las esquinas
# redondeadas para que el desenfoque no asome fuera de la superficie.
[[layer_rule]]
match.namespace = "^shell-(bar|side-panel|launcher|calendar|battery|tray|power|app-menu|osd|move-menu|welcome-mode|window-mode)\$"
blur = true
blur_popups = true
blur_ignore_alpha = $ignore_alpha
blur_optimized = $optimized

# Superficies transparentes a pantalla completa o que no son cristal: no
# deben crear una región de desenfoque.
[[layer_rule]]
match.namespace = "^shell-(wallpaper|desktop-icons|outside-close|filter)\$"
blur = false
# shell-glass: fin
EOF
}

current_block() {
    [ -f "$cfg" ] || return 0
    sed -n "/^$start_marker\$/,/^$end_marker\$/p" "$cfg"
}

# Modo actual del bloque. Sin bloque, o sin la clave, se asume el valor global
# por defecto (solo fondo de pantalla).
current_optimized() {
    block=$(current_block)
    case "$block" in
        *'blur_optimized = false'*) printf 'false\n' ;;
        *) printf 'true\n' ;;
    esac
}

replace_block() {
    optimized=$1
    config_set=$(find_config_set) \
        || { echo "falta shell-config-set" >&2; exit 1; }

    tmp=$(mktemp "${TMPDIR:-/tmp}/shell-glass.XXXXXX")
    trap 'rm -f "$tmp"' EXIT
    layer_block "$optimized" >"$tmp"

    if [ -n "$(current_block)" ]; then
        status=$("$config_set" --drop-block "$start_marker" "$end_marker" \
            --append-block "$tmp") || exit $?
    else
        status=$("$config_set" --append-block "$tmp") || exit $?
    fi
    if [ "$status" = changed ]; then
        reload
    fi
    printf '%s\n' "$status"
}

ensure() {
    [ -f "$cfg" ] || exit 0
    optimized=$(current_optimized)
    if [ -n "$(current_block)" ] \
        && [ "$(current_block)" = "$(layer_block "$optimized")" ]; then
        printf 'unchanged\n'
        return 0
    fi
    replace_block "$optimized"
}

mode() {
    value=${1:-}
    case "$value" in
        wallpaper|fondo) optimized=true ;;
        behind|content|contenido) optimized=false ;;
        *)
            echo "uso: shell-glass mode wallpaper|behind" >&2
            exit 2
            ;;
    esac

    [ -f "$cfg" ] || exit 0
    if [ "$(current_block)" = "$(layer_block "$optimized")" ]; then
        printf 'unchanged\n'
        return 0
    fi
    replace_block "$optimized"
}

blur() {
    value=${1:-}
    case "$value" in
        ''|*[!0-9]*)
            echo "uso: shell-glass blur <0-100>" >&2
            exit 2
            ;;
    esac
    value=$(printf '%s\n' "$value" | sed 's/^0*//')
    [ -n "$value" ] || value=0
    if [ "$value" -gt 100 ]; then
        echo "el radio debe estar entre 0 y 100" >&2
        exit 2
    fi

    [ -f "$cfg" ] || exit 0
    config_set=$(find_config_set) \
        || { echo "falta shell-config-set" >&2; exit 1; }
    if [ "$value" -eq 0 ]; then
        status=$("$config_set" --section appearance.blur \
            enabled=false radius=0) || exit $?
    else
        status=$("$config_set" --section appearance.blur \
            enabled=true "radius=$value") || exit $?
    fi
    if [ "$status" = changed ]; then
        reload
    fi
    printf '%s\n' "$status"
}

# Bloque de ventanas transparentes. Umbriel aplica `opacity` a la ventana y
# `blur` al contenido que queda detrás; no desenfoca el contenido propio de la
# app. `blur_optimized = false` usa el contenido real, como el modo «behind» de
# las capas del shell.
window_block() {
    opacity=$1
    blur=$2
    cat <<EOF
$wstart_marker
# Ventanas transparentes del shell. La opacidad se calcula desde el
# porcentaje del centro de control y el desenfoque usa el contenido real
# que hay detrás. Al poner 0 % el bloque se elimina.
[[window_rule]]
opacity = $opacity
blur = $blur
blur_optimized = false
$wend_marker
EOF
}

current_window_block() {
    [ -f "$cfg" ] || return 0
    sed -n "/^$wstart_marker\$/,/^$wend_marker\$/p" "$cfg"
}

windows() {
    value=${1:-}
    blur=${2:-}
    case "$value" in
        ''|*[!0-9]*)
            echo "uso: shell-glass windows <0-90> <0|1>" >&2
            exit 2
            ;;
    esac
    value=$(printf '%s\n' "$value" | sed 's/^0*//')
    [ -n "$value" ] || value=0
    if [ "$value" -gt 90 ]; then
        echo "la transparencia debe estar entre 0 y 90" >&2
        exit 2
    fi
    case "$blur" in
        0|1) ;;
        *)
            echo "uso: shell-glass windows <0-90> <0|1>" >&2
            exit 2
            ;;
    esac

    [ -f "$cfg" ] || exit 0
    config_set=$(find_config_set) \
        || { echo "falta shell-config-set" >&2; exit 1; }

    tmp=$(mktemp "${TMPDIR:-/tmp}/shell-windows.XXXXXX")
    trap 'rm -f "$tmp"' EXIT

    if [ "$value" -eq 0 ]; then
        if [ -z "$(current_window_block)" ]; then
            printf 'unchanged\n'
            return 0
        fi
        : >"$tmp"
        status=$("$config_set" --drop-block "$wstart_marker" "$wend_marker") \
            || exit $?
    else
        opacity=$(awk -v pct="$value" 'BEGIN { printf "%.3f", (100 - pct) / 100 }')
        if [ "$blur" = 1 ]; then
            blur_value=true
        else
            blur_value=false
        fi
        window_block "$opacity" "$blur_value" >"$tmp"
        if [ -n "$(current_window_block)" ]; then
            status=$("$config_set" --drop-block "$wstart_marker" "$wend_marker" \
                --append-block "$tmp") || exit $?
        else
            status=$("$config_set" --append-block "$tmp") || exit $?
        fi
    fi
    if [ "$status" = changed ]; then
        reload
    fi
    printf '%s\n' "$status"
}

tone() {
    mode=${1:-}
    case "$mode" in
        dark|light) ;;
        *)
            echo "uso: shell-glass tone dark|light" >&2
            exit 2
            ;;
    esac
    [ -f "$cfg" ] || exit 0
    config_set=$(find_config_set) \
        || { echo "falta shell-config-set" >&2; exit 1; }
    load_blur_conf
    if [ "$mode" = dark ]; then
        brightness=$(clamp_real "$DARK_BRIGHTNESS" 0 2)
        contrast=$(clamp_real "$DARK_CONTRAST" 0 2)
        saturation=$(clamp_real "$DARK_SATURATION" 0 2)
    else
        brightness=$(clamp_real "$LIGHT_BRIGHTNESS" 0 2)
        contrast=$(clamp_real "$LIGHT_CONTRAST" 0 2)
        saturation=$(clamp_real "$LIGHT_SATURATION" 0 2)
    fi
    passes=$(clamp_int "$BLUR_PASSES" 0 8)
    status=$("$config_set" --section appearance.blur \
        "brightness=$brightness" "contrast=$contrast" \
        "saturation=$saturation" "passes=$passes") || exit $?
    if [ "$status" = changed ]; then
        reload
    fi
    printf '%s\n' "$status"
}

status() {
    block=$(current_block)
    if [ -n "$block" ]; then
        printf 'reglas: presentes\n'
        if [ "$(current_optimized)" = false ]; then
            printf 'desenfoque: contenido detrás\n'
        else
            printf 'desenfoque: fondo de pantalla\n'
        fi
        case "$block" in
            *"blur_ignore_alpha = $ignore_alpha"*)
                printf 'esquinas: recortadas\n' ;;
            *)
                printf 'esquinas: sin recortar\n' ;;
        esac
    else
        printf 'reglas: ausentes\n'
    fi

    if [ -n "$(current_window_block)" ]; then
        printf 'ventanas: transparentes\n'
        current_window_block | awk '
            /^opacity[[:space:]]*=/ { gsub(/[[:space:]]/, "", $0); printf "ventanas %s ", $0 }
            /^blur[[:space:]]*=/ { gsub(/[[:space:]]/, "", $0); printf "%s\n", $0 }
        '
    else
        printf 'ventanas: opacas\n'
    fi

    if [ -f "$cfg" ]; then
        awk '
            /^[[:space:]]*\[appearance\.blur\][[:space:]]*$/ { on = 1; next }
            /^[[:space:]]*\[/ { on = 0 }
            on && /^[[:space:]]*(enabled|radius|passes)[[:space:]]*=/ {
                gsub(/[[:space:]]/, "", $0)
                printf "%s ", $0
            }
        ' "$cfg"
        printf '\n'
    fi
}

case "${1:-}" in
    ensure) ensure ;;
    mode) shift; mode "${1:-}" ;;
    blur) shift; blur "${1:-}" ;;
    windows) shift; windows "${1:-}" "${2:-}" ;;
    tone) shift; tone "${1:-}" ;;
    status) status ;;
    -h | --help) usage ;;
    *) usage >&2; exit 2 ;;
esac
