#!/usr/bin/env python3
"""Demonio de alarmas del shell.

Lee ~/.config/shell/alarms.conf (una línea «enabled|HH:MM|etiqueta» por alarma)
y, cuando llega la hora, muestra un aviso y reproduce el sonido de alarma.

Si el shell está abierto, no hace nada: el propio panel del reloj ya
avisa y no queremos avisos duplicados. Cuando el shell está cerrado no hay
servidor de notificaciones, así que `notify-send` falla y se usa un cuadro de
diálogo visible (KDialog o Zenity).

Opciones (para pruebas):
  --once    evalúa una sola vez y termina
  --force   avisa aunque el shell esté abierto
  --stop    detiene el aviso que esté sonando fuera del shell
"""

from __future__ import annotations

import datetime
import os
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

POLL_SECONDS = 20
# Al entrar en la sesión, qs puede tardar unos segundos en arrancar. Si una
# alarma vence justo en ese momento, esperamos a que el shell aparezca para no
# avisar dos veces: el panel del reloj ya se encarga cuando está abierto.
SHELL_GRACE_SECONDS = 25
SOUND = "/usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga"
TIMER_SOUND = "/usr/share/sounds/freedesktop/stereo/complete.oga"


def config_dir() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME", "")
    if not base:
        base = str(Path.home() / ".config")
    return Path(base) / "shell"


def alarms_path() -> Path:
    override = os.environ.get("SHELL_ALARMS_FILE", "")
    if override:
        return Path(override)
    return config_dir() / "alarms.conf"


def timer_path() -> Path:
    override = os.environ.get("SHELL_TIMER_FILE", "")
    if override:
        return Path(override)
    return config_dir() / "timer.conf"


def load_alarms(path: Path) -> list[tuple[str, str]]:
    alarms: list[tuple[str, str]] = []
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return alarms
    for line in lines:
        parts = line.split("|", 2)
        if len(parts) != 3 or parts[0].strip() != "1":
            continue
        at = parts[1].strip()
        label = parts[2].strip() or "Alarma"
        if len(at) != 5 or at[2] != ":":
            continue
        try:
            hour, minute = int(at[:2]), int(at[3:])
        except ValueError:
            continue
        if not (0 <= hour < 24 and 0 <= minute < 60):
            continue
        alarms.append((at, label))
    return alarms


def shell_running() -> bool:
    try:
        result = subprocess.run(
            ["pgrep", "-x", "qs"], capture_output=True, text=True, timeout=3
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return bool(result.stdout.strip())


def grace_seconds() -> int:
    """Segundos de espera al arrancar. La variable existe para las pruebas."""
    value = os.environ.get("SHELL_ALARM_SHELL_GRACE", "")
    try:
        return max(0, int(value))
    except ValueError:
        return SHELL_GRACE_SECONDS


def wait_for_shell() -> bool:
    """Espera a que qs arranque antes de avisar por nuestra cuenta.

    En un inicio de sesión, el servicio y el shell compiten. Si la alarma
    vence en ese hueco, el demonio avisaba con kdialog/zenity y su sonido no
    podía pararse desde el reloj del shell, que todavía no estaba abierto.
    """
    deadline = time.monotonic() + grace_seconds()
    while True:
        if shell_running():
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.5)


def state_path() -> Path:
    """Archivo con el grupo de procesos del aviso externo en curso."""
    base = os.environ.get("XDG_RUNTIME_DIR", "") or "/tmp"
    return Path(base) / f"shell-alarm-{os.getuid()}.state"


def mark_state(sound: int = 0, dialog: int = 0) -> None:
    """Anota los procesos del aviso en curso.

    El sonido y el aviso son procesos distintos: el diálogo o `notify-send`
    lo lanza el propio demonio, así que matar solo el bucle de sonido dejaría
    una ventana abierta. Se guardan ambos para que `--stop` cierre todo.
    """
    lines = []
    if sound > 0:
        lines.append(f"sound={sound}")
    if dialog > 0:
        lines.append(f"dialog={dialog}")
    # Se escribe de forma atómica para que el shell nunca lea un pid a medias.
    try:
        path = state_path()
        temp = path.with_name(path.name + ".tmp")
        temp.write_text("\n".join(lines) + "\n", encoding="ascii")
        os.replace(temp, path)
    except OSError:
        pass


def clear_active() -> None:
    try:
        state_path().unlink()
    except OSError:
        pass


def stop_active() -> None:
    """Detiene el aviso que esté sonando fuera del shell.

    El reloj de la barra ejecuta `shell-alarms --stop`. Se comprueba que el
    pid siga siendo un reproductor o un diálogo de alarma para no matar un
    proceso reciclado.
    """
    try:
        lines = state_path().read_text(encoding="ascii").splitlines()
    except OSError:
        return
    markers = (
        b"shell-alarm", b"pw-play", b"paplay", b"canberra-gtk-play",
        b"notify-send", b"kdialog", b"zenity",
    )
    for line in lines:
        _, _, value = line.partition("=")
        try:
            pid = int(value.strip())
        except ValueError:
            continue
        if pid <= 0:
            continue
        try:
            command = Path(f"/proc/{pid}/cmdline").read_bytes()
            command = command.replace(b"\x00", b" ")
        except OSError:
            continue
        # Si el pid ya no es un proceso de alarma, se ignora: podría haberse
        # reciclado para otro programa.
        if not any(marker in command for marker in markers):
            continue
        try:
            os.killpg(pid, signal.SIGTERM)
        except OSError:
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass


def play_loop(sound: str = SOUND, event: str = "alarm-clock-elapsed") -> subprocess.Popen | None:
    """Repite el sonido hasta que se pare el proceso."""
    # pw-play viene con PipeWire, que el shell ya necesita. paplay solo queda
    # como respaldo para instalaciones antiguas con PulseAudio.
    if not (shutil.which("pw-play") or shutil.which("paplay")
            or shutil.which("canberra-gtk-play")):
        return None
    script = (
        'while :; do pw-play "$1" 2>/dev/null '
        '|| paplay "$1" 2>/dev/null '
        '|| canberra-gtk-play -f "$2" 2>/dev/null '
        "|| sleep 1; done"
    )
    try:
        # $0 lleva un nombre reconocible: `--stop` lo usa para comprobar que
        # el grupo de procesos sigue siendo el de la alarma y no un pid
        # reutilizado por otro programa.
        return subprocess.Popen(
            ["sh", "-c", script, "shell-alarm", sound, event],
            start_new_session=True,
        )
    except OSError:
        return None


def stop_loop(process: subprocess.Popen | None) -> None:
    if process is None:
        return
    # El bucle arranca en su propia sesión: matar el grupo corta también el
    # reproductor que esté sonando, sin esperar a que termine la secuencia.
    try:
        os.killpg(os.getpgid(process.pid), signal.SIGTERM)
    except (OSError, ProcessLookupError):
        try:
            process.terminate()
        except OSError:
            pass
    try:
        process.wait(timeout=2)
    except (OSError, subprocess.TimeoutExpired):
        try:
            process.kill()
        except OSError:
            pass


def run_with_sound(
    command: list[str],
    timeout: int = 900,
    sound: str = SOUND,
    event: str = "alarm-clock-elapsed",
) -> bool:
    process = play_loop(sound, event)
    if process is not None:
        mark_state(sound=process.pid)
    dialog = None
    try:
        dialog = subprocess.Popen(command, start_new_session=True)
        mark_state(sound=process.pid if process is not None else 0,
                   dialog=dialog.pid)
        try:
            dialog.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            # Quince minutos de aviso son suficientes aunque nadie lo cierre.
            pass
        return True
    except OSError:
        return False
    finally:
        stop_loop(process)
        stop_loop(dialog)
        clear_active()


def notify(
    title: str,
    body: str,
    sound: str = SOUND,
    event: str = "alarm-clock-elapsed",
) -> None:
    # `notify-send -w` espera a que se cierre el aviso, así que el sonido
    # sigue sonando hasta que el usuario lo elimina.
    if shutil.which("notify-send"):
        if run_with_sound(
            [
                "notify-send", "-a", "Shell", "-u", "critical", "-t", "0",
                "-i", "alarm-clock-elapsed", "-w", title, body,
            ],
            sound=sound,
            event=event,
        ):
            return

    # Sin servidor de notificaciones: un diálogo que hay que cerrar.
    for command in (
        ["kdialog", "--title", title, "--msgbox", body],
        ["zenity", "--info", "--title", title, "--text", body],
    ):
        if shutil.which(command[0]):
            if run_with_sound(command, sound=sound, event=event):
                return

    play_sound(sound, event)


def play_sound(sound: str = SOUND, event: str = "alarm-clock-elapsed") -> None:
    for command in (
        ["pw-play", sound],
        ["paplay", sound],
        ["canberra-gtk-play", "-f", event],
    ):
        if shutil.which(command[0]):
            try:
                process = subprocess.Popen(command, start_new_session=True)
            except OSError:
                continue
            mark_state(sound=process.pid)
            try:
                process.wait(timeout=30)
            except (OSError, subprocess.TimeoutExpired):
                stop_loop(process)
            finally:
                clear_active()
            return


def due(alarms: list[tuple[str, str]], stamp: str) -> list[tuple[str, str]]:
    return [alarm for alarm in alarms if alarm[0] == stamp]


def timer_deadline(path: Path) -> int:
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return 0
    for line in lines:
        if not line.startswith("deadline="):
            continue
        try:
            return int(line.split("=", 1)[1].strip())
        except ValueError:
            return 0
    return 0


def fire_timer(path: Path) -> None:
    # Renombrar es atómico: si el shell también intenta atenderlo, solo uno
    # de los dos se queda el archivo y avisa.
    claimed = path.with_name(path.name + ".fired")
    try:
        os.replace(path, claimed)
    except OSError:
        return
    notify("Temporizador", "Tiempo cumplido", TIMER_SOUND, "complete")
    try:
        claimed.unlink()
    except OSError:
        pass


def run(once: bool, force: bool) -> int:
    fired: set[tuple[str, str, str]] = set()
    while True:
        now = datetime.datetime.now()
        stamp = now.strftime("%H:%M")
        today = now.strftime("%Y-%m-%d")

        pending = due(load_alarms(alarms_path()), stamp)
        deadline = timer_deadline(timer_path())
        timer_due = deadline > 0 and deadline <= int(time.time())

        # Con el shell en marcha, el panel del reloj es quien avisa y suena.
        # Si estamos arrancando la sesión, damos un margen para que qs
        # aparezca antes de reclamar la alarma para nosotros.
        shell_alive = False if force else shell_running()
        if not force and not shell_alive and (pending or timer_due):
            shell_alive = wait_for_shell()

        if not shell_alive:
            for at, label in pending:
                key = (today, at, label)
                if key in fired:
                    continue
                fired.add(key)
                notify("Alarma", f"{label} · {at}")

            if timer_due:
                fire_timer(timer_path())

        # Solo hace falta recordar lo disparado durante el día actual.
        fired = {key for key in fired if key[0] == today}

        if once:
            return 0
        time.sleep(POLL_SECONDS)


def main() -> int:
    if "--stop" in sys.argv[1:]:
        stop_active()
        return 0
    once = "--once" in sys.argv[1:]
    force = "--force" in sys.argv[1:]
    try:
        return run(once, force)
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
