#!/usr/bin/env python3
"""Demonio de alarmas del shell.

Lee ~/.config/shell/alarms.conf (una línea «enabled|HH:MM|etiqueta» por alarma)
y, cuando llega la hora, muestra un aviso y reproduce el sonido de alarma.

Si el shell está abierto, no hace nada: el propio panel del reloj ya
avisa y no queremos avisos duplicados. Cuando el shell está cerrado no hay
servidor de notificaciones, así que `notify-send` falla y se usa un cuadro de
diálogo visible (KDialog o Zenity).

Opciones (para pruebas):
  --once    evalúa una sola vez y termina
  --force   avisa aunque el shell esté abierto
"""

from __future__ import annotations

import datetime
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

POLL_SECONDS = 20
SOUND = "/usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga"
TIMER_SOUND = "/usr/share/sounds/freedesktop/stereo/complete.oga"


def config_dir() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME", "")
    if not base:
        base = str(Path.home() / ".config")
    return Path(base) / "shell"


def alarms_path() -> Path:
    override = os.environ.get("SHELL_ALARMS_FILE", "")
    if override:
        return Path(override)
    return config_dir() / "alarms.conf"


def timer_path() -> Path:
    override = os.environ.get("SHELL_TIMER_FILE", "")
    if override:
        return Path(override)
    return config_dir() / "timer.conf"


def load_alarms(path: Path) -> list[tuple[str, str]]:
    alarms: list[tuple[str, str]] = []
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return alarms
    for line in lines:
        parts = line.split("|", 2)
        if len(parts) != 3 or parts[0].strip() != "1":
            continue
        at = parts[1].strip()
        label = parts[2].strip() or "Alarma"
        if len(at) != 5 or at[2] != ":":
            continue
        try:
            hour, minute = int(at[:2]), int(at[3:])
        except ValueError:
            continue
        if not (0 <= hour < 24 and 0 <= minute < 60):
            continue
        alarms.append((at, label))
    return alarms


def shell_running() -> bool:
    try:
        result = subprocess.run(
            ["pgrep", "-x", "qs"], capture_output=True, text=True, timeout=3
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return bool(result.stdout.strip())


def play_loop(sound: str = SOUND, event: str = "alarm-clock-elapsed") -> subprocess.Popen | None:
    """Repite el sonido hasta que se pare el proceso."""
    if not (shutil.which("paplay") or shutil.which("canberra-gtk-play")):
        return None
    script = (
        'while :; do paplay "$1" 2>/dev/null '
        '|| canberra-gtk-play -f "$2" 2>/dev/null '
        "|| sleep 1; done"
    )
    try:
        return subprocess.Popen(["sh", "-c", script, "shell", sound, event])
    except OSError:
        return None


def stop_loop(process: subprocess.Popen | None) -> None:
    if process is None:
        return
    try:
        process.terminate()
        process.wait(timeout=2)
    except (OSError, subprocess.TimeoutExpired):
        try:
            process.kill()
        except OSError:
            pass


def run_with_sound(
    command: list[str],
    timeout: int = 900,
    sound: str = SOUND,
    event: str = "alarm-clock-elapsed",
) -> bool:
    process = play_loop(sound, event)
    try:
        subprocess.run(command, timeout=timeout)
        return True
    except subprocess.TimeoutExpired:
        # Quince minutos de aviso son suficientes aunque nadie lo cierre.
        return True
    except OSError:
        return False
    finally:
        stop_loop(process)


def notify(
    title: str,
    body: str,
    sound: str = SOUND,
    event: str = "alarm-clock-elapsed",
) -> None:
    # `notify-send -w` espera a que se cierre el aviso, así que el sonido
    # sigue sonando hasta que el usuario lo elimina.
    if shutil.which("notify-send"):
        if run_with_sound(
            [
                "notify-send", "-a", "Shell", "-u", "critical", "-t", "0",
                "-i", "alarm-clock-elapsed", "-w", title, body,
            ],
            sound=sound,
            event=event,
        ):
            return

    # Sin servidor de notificaciones: un diálogo que hay que cerrar.
    for command in (
        ["kdialog", "--title", title, "--msgbox", body],
        ["zenity", "--info", "--title", title, "--text", body],
    ):
        if shutil.which(command[0]):
            if run_with_sound(command, sound=sound, event=event):
                return

    play_sound(sound, event)


def play_sound(sound: str = SOUND, event: str = "alarm-clock-elapsed") -> None:
    for command in (
        ["paplay", sound],
        ["canberra-gtk-play", "-f", event],
    ):
        if shutil.which(command[0]):
            try:
                subprocess.Popen(command)
            except OSError:
                continue
            return


def due(alarms: list[tuple[str, str]], stamp: str) -> list[tuple[str, str]]:
    return [alarm for alarm in alarms if alarm[0] == stamp]


def timer_deadline(path: Path) -> int:
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return 0
    for line in lines:
        if not line.startswith("deadline="):
            continue
        try:
            return int(line.split("=", 1)[1].strip())
        except ValueError:
            return 0
    return 0


def fire_timer(path: Path) -> None:
    # Renombrar es atómico: si el shell también intenta atenderlo, solo uno
    # de los dos se queda el archivo y avisa.
    claimed = path.with_name(path.name + ".fired")
    try:
        os.replace(path, claimed)
    except OSError:
        return
    notify("Temporizador", "Tiempo cumplido", TIMER_SOUND, "complete")
    try:
        claimed.unlink()
    except OSError:
        pass


def run(once: bool, force: bool) -> int:
    fired: set[tuple[str, str, str]] = set()
    while True:
        now = datetime.datetime.now()
        stamp = now.strftime("%H:%M")
        today = now.strftime("%Y-%m-%d")

        if force or not shell_running():
            for at, label in due(load_alarms(alarms_path()), stamp):
                key = (today, at, label)
                if key in fired:
                    continue
                fired.add(key)
                notify("Alarma", f"{label} · {at}")

            deadline = timer_deadline(timer_path())
            if deadline > 0 and deadline <= int(time.time()):
                fire_timer(timer_path())

        # Solo hace falta recordar lo disparado durante el día actual.
        fired = {key for key in fired if key[0] == today}

        if once:
            return 0
        time.sleep(POLL_SECONDS)


def main() -> int:
    once = "--once" in sys.argv[1:]
    force = "--force" in sys.argv[1:]
    try:
        return run(once, force)
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
