#!/bin/sh
# Aplica el estilo de barra de ventanas al compositor Umbriel.
#
# Uso: shell-window-chrome floating|integrated
#
# «floating» dibuja la barra dentro del contenido y solo la muestra mientras se
# mantiene Mod. «integrated» la deja encima, siempre visible. En ambos casos la
# barra es nativa: la pinta Umbriel, no el shell. El ajuste se guarda en la
# configuración del compositor mediante el escritor único.
set -eu

style="${1:-floating}"
case "$style" in
    integrated) want=false ;;
    floating|*) want=true ;;
esac

cfg="${UMBRIEL_CONFIG:-$HOME/.config/umbriel/config.toml}"
[ -f "$cfg" ] || exit 0

config_set="${SHELL_CONFIG_SET:-$HOME/.local/bin/shell-config-set}"
if [ ! -x "$config_set" ]; then
    config_set=$(command -v shell-config-set 2>/dev/null || true)
fi
if [ ! -x "$config_set" ]; then
    here=$(cd "$(dirname "$0")" && pwd)
    for candidate in "$here/shell-config-set" "$here/../install/bin/shell-config-set"; do
        if [ -x "$candidate" ]; then
            config_set=$candidate
            break
        fi
    done
fi
[ -n "$config_set" ] && [ -x "$config_set" ] \
    || { echo "falta shell-config-set" >&2; exit 1; }

status=$("$config_set" --section appearance.title_bar "overlay=$want") || exit $?
[ "$status" = "unchanged" ] && exit 0

# El compositor vigila el archivo, pero el aviso explícito hace el cambio
# inmediato también cuando el vigilante no está disponible.
umbriel msg config-reload >/dev/null 2>&1 || true
