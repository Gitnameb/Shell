#!/usr/bin/env python3
"""Añade al historial el texto que recibe por la entrada estándar.

Lo ejecuta `wl-paste --watch` cada vez que cambia el portapapeles. Se guarda
solo texto, se eliminan duplicados y se conservan las 50 entradas más
recientes en ~/.local/state/alba/clipboard.json.
"""

import json
import os
import sys
import time
from pathlib import Path

MAX_ENTRIES = 50
MAX_BYTES = 400000

path = Path.home() / ".local/state/alba/clipboard.json"
first_flag = Path.home() / ".local/state/alba/clipboard-first"


def main():
    # La primera ejecución de wl-paste --watch entrega el portapapeles actual.
    if first_flag.exists():
        try:
            first_flag.unlink()
        except OSError:
            pass
        return

    try:
        raw = sys.stdin.buffer.read()
    except OSError:
        return
    if not raw or len(raw) > MAX_BYTES:
        return
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        return
    if not text.strip():
        return

    entries = []
    try:
        loaded = json.loads(path.read_text(encoding="utf-8"))
        if isinstance(loaded, list):
            for item in loaded:
                if isinstance(item, str):
                    entries.append({"text": item, "time": 0})
                elif isinstance(item, dict) and isinstance(item.get("text"), str):
                    entries.append({
                        "text": item["text"],
                        "time": int(item.get("time") or 0),
                    })
    except (OSError, ValueError):
        entries = []

    entries = [entry for entry in entries if entry["text"] != text]
    entries.insert(0, {"text": text, "time": int(time.time() * 1000)})
    entries = entries[:MAX_ENTRIES]

    path.parent.mkdir(parents=True, exist_ok=True)
    os.umask(0o077)
    # Se escribe en el mismo archivo (sin renombrar) para que el vigilante de
    # FileView en Quickshell siga viendo los cambios.
    with open(path, "w", encoding="utf-8") as handle:
        json.dump(entries, handle, ensure_ascii=False)
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(path, 0o600)


if __name__ == "__main__":
    main()
