#!/bin/sh
# Aplica el tamaño y la cascada de las ventanas flotantes a Umbriel.
#
# Uso: alba-floating-defaults <porcentaje> <separación>
#
# El porcentaje (40–80) se escribe como fracción del área útil en
# default_width_fraction y default_height_fraction. La separación en píxeles
# va a cascade_step; 0 deja que Umbriel la calcule desde la barra de título.
# Después de escribir, el compositor recarga la configuración.
set -eu

percent="${1:-60}"
step="${2:-0}"
case "$percent" in
    ''|*[!0-9]*) exit 2 ;;
esac
case "$step" in
    ''|*[!0-9]*) exit 2 ;;
esac
[ "$percent" -ge 40 ] && [ "$percent" -le 80 ] || exit 2
[ "$step" -ge 0 ] && [ "$step" -le 96 ] || exit 2

fraction=$(awk -v p="$percent" 'BEGIN { printf "%.2f", p / 100 }')

cfg="${UMBRIEL_CONFIG:-$HOME/.config/umbriel/config.toml}"
[ -f "$cfg" ] || exit 0

# La recarga de ALBA puede lanzar este script y el del retardo a la vez. Un
# cerrojo por archivo y un temporal único evitan que uno mueva el archivo
# mientras el otro lo está escribiendo.
if command -v flock >/dev/null 2>&1 && command -v mktemp >/dev/null 2>&1; then
    exec 9>"$cfg.alba-lock"
    flock 9
    tmp=$(mktemp "$cfg.alba-XXXXXX")
    trap 'rm -f "$tmp"' EXIT
else
    tmp="$cfg.alba-tmp-$$"
    trap 'rm -f "$tmp"' EXIT
fi

current=$(awk '
    /^\[/ { in_stacking = ($0 ~ /^\[layout\.stacking\]/); next }
    in_stacking && /^default_width_fraction[ \t]*=/ {
        sub(/^default_width_fraction[ \t]*=[ \t]*/, "")
        sub(/[ \t\r]+$/, "")
        print
        exit
    }
' "$cfg")
current_step=$(awk '
    /^\[/ { in_stacking = ($0 ~ /^\[layout\.stacking\]/); next }
    in_stacking && /^cascade_step[ \t]*=/ {
        sub(/^cascade_step[ \t]*=[ \t]*/, "")
        sub(/[ \t\r]+$/, "")
        print
        exit
    }
' "$cfg")

# Ya está en los valores pedidos: no se toca el archivo ni se recarga nada.
[ "$current" = "$fraction" ] && [ "$current_step" = "$step" ] && exit 0

awk -v dw="$fraction" -v dh="$fraction" -v cs="$step" '
    function flush_section() {
        if (!in_stacking)
            return
        if (!have_width)
            print "default_width_fraction = " dw
        if (!have_height)
            print "default_height_fraction = " dh
        if (!have_step)
            print "cascade_step = " cs
    }
    BEGIN { in_stacking = 0; have_section = 0
            have_width = 0; have_height = 0; have_step = 0 }
    /^\[/ {
        flush_section()
        in_stacking = ($0 ~ /^\[layout\.stacking\]/)
        if (in_stacking)
            have_section = 1
        have_width = have_height = have_step = 0
        print
        next
    }
    in_stacking && /^default_width_fraction[ \t]*=/ {
        print "default_width_fraction = " dw
        have_width = 1
        next
    }
    in_stacking && /^default_height_fraction[ \t]*=/ {
        print "default_height_fraction = " dh
        have_height = 1
        next
    }
    in_stacking && /^cascade_step[ \t]*=/ {
        print "cascade_step = " cs
        have_step = 1
        next
    }
    { print }
    END {
        flush_section()
        if (!have_section) {
            print ""
            print "[layout.stacking]"
            print "default_width_fraction = " dw
            print "default_height_fraction = " dh
            print "cascade_step = " cs
        }
    }
' "$cfg" > "$tmp"

mv "$tmp" "$cfg"
trap - EXIT

# El compositor vigila el archivo; el aviso explícito aplica el cambio aunque
# el vigilante no esté disponible.
umbriel msg config-reload >/dev/null 2>&1 || true
