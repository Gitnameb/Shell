#!/usr/bin/env python3
"""Escribe el filtro de pantalla de ALBA en la configuración de Umbriel.

Uso: alba-display-filter <brillo> <atenuación> <calidez>

Los tres valores van de 0 a 1 (la atenuación se limita a 0.8) y se guardan en
la tabla [display]. Umbriel los aplica como un shader de salida completo, así
que la barra, los paneles y las ventanas reciben el mismo filtro. Después pide
una recarga; si los valores no cambian, no toca el archivo.
"""

import os
import re
import shutil
import subprocess
import sys
from pathlib import Path


def clamp(value: float, low: float, high: float) -> float:
    return max(low, min(high, value))


def parse(name: str) -> float:
    try:
        return clamp(float(name), 0.0, 1.0)
    except ValueError:
        return 0.0


def format_value(value: float) -> str:
    return f"{value:.3f}"


def main() -> int:
    brightness = parse(sys.argv[1]) if len(sys.argv) > 1 else 1.0
    extra_dim = clamp(parse(sys.argv[2]) if len(sys.argv) > 2 else 0.0, 0.0, 0.8)
    warm = parse(sys.argv[3]) if len(sys.argv) > 3 else 0.0

    config = Path(
        os.environ.get("UMBRIEL_CONFIG", "")
        or Path.home() / ".config" / "umbriel" / "config.toml"
    )
    if not config.is_file():
        return 0

    desired = {
        "brightness": format_value(brightness),
        "extra_dim": format_value(extra_dim),
        "warm": format_value(warm),
    }

    lines = config.read_text(encoding="utf-8").splitlines()
    section = None
    changed = False
    seen = set()
    output = []
    key_re = re.compile(r"^\s*(brightness|extra_dim|warm)\s*=")

    for line in lines:
        section_match = re.match(r"^\s*\[([^\]]+)\]\s*(?:#.*)?$", line)
        if section_match:
            # Al cerrar la tabla [display], añade las claves que falten.
            if section == "display":
                for key, value in desired.items():
                    if key not in seen:
                        output.append(f"{key} = {value}")
                        seen.add(key)
                        changed = True
            section = section_match.group(1).strip()
            output.append(line)
            continue

        if section == "display" and key_re.match(line):
            key = key_re.match(line).group(1)
            new_line = f"{key} = {desired[key]}"
            if line.strip() != new_line:
                changed = True
            output.append(new_line)
            seen.add(key)
            continue

        output.append(line)

    if section == "display":
        for key, value in desired.items():
            if key not in seen:
                output.append(f"{key} = {value}")
                seen.add(key)
                changed = True

    if "display" not in {re.match(r"^\s*\[([^\]]+)\]", line).group(1).strip()
                         for line in output
                         if re.match(r"^\s*\[([^\]]+)\]", line)}:
        if output and output[-1].strip():
            output.append("")
        output.extend([
            "[display]",
            f"brightness = {desired['brightness']}",
            f"extra_dim = {desired['extra_dim']}",
            f"warm = {desired['warm']}",
        ])
        changed = True

    if not changed:
        return 0

    config.write_text("\n".join(output) + "\n", encoding="utf-8")

    umbriel = shutil.which("umbriel") or "/usr/bin/umbriel"
    subprocess.run(
        [umbriel, "msg", "config-reload"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
