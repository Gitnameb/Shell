#!/usr/bin/env python3
"""Escribe el filtro de pantalla del shell en la configuración de Umbriel.

Uso: shell-display-filter <brillo> <atenuación> <calidez>

Los tres valores van de 0 a 1 (la atenuación se limita a 0.8) y se guardan en
la tabla [display]. Umbriel los aplica como un shader de salida completo, así
que la barra, los paneles y las ventanas reciben el mismo filtro. La escritura
la hace shell-config-set, que serializa, valida y sustituye el archivo de una
vez. Después se pide una recarga; si los valores no cambian, no se toca nada.
"""

import os
import shutil
import subprocess
import sys
from pathlib import Path


def find_writer() -> str | None:
    candidates = []
    env = os.environ.get("SHELL_CONFIG_SET", "")
    if env:
        candidates.append(env)
    candidates.append(str(Path.home() / ".local" / "bin" / "shell-config-set"))

    here = Path(__file__).resolve().parent
    candidates.extend([
        str(here / "shell-config-set"),
        str(here.parent / "install" / "bin" / "shell-config-set"),
    ])

    for candidate in candidates:
        if os.access(candidate, os.X_OK):
            return candidate
    return None


def clamp(value: float, low: float, high: float) -> float:
    return max(low, min(high, value))


def parse(name: str) -> float:
    try:
        return clamp(float(name), 0.0, 1.0)
    except ValueError:
        return 0.0


def format_value(value: float) -> str:
    return f"{value:.3f}"


def main() -> int:
    brightness = parse(sys.argv[1]) if len(sys.argv) > 1 else 1.0
    extra_dim = clamp(parse(sys.argv[2]) if len(sys.argv) > 2 else 0.0, 0.0, 0.8)
    warm = parse(sys.argv[3]) if len(sys.argv) > 3 else 0.0

    config = Path(
        os.environ.get("UMBRIEL_CONFIG", "")
        or Path.home() / ".config" / "umbriel" / "config.toml"
    )
    if not config.is_file():
        return 0

    writer = find_writer()
    if writer is None:
        print("shell-display-filter: falta shell-config-set", file=sys.stderr)
        return 1

    desired = {
        "brightness": format_value(brightness),
        "extra_dim": format_value(extra_dim),
        "warm": format_value(warm),
    }

    result = subprocess.run(
        [writer, "--section", "display"]
        + [f"{key}={value}" for key, value in desired.items()],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        sys.stderr.write(result.stderr)
        return result.returncode
    if result.stdout.strip() != "changed":
        return 0

    umbriel = shutil.which("umbriel") or "/usr/bin/umbriel"
    subprocess.run(
        [umbriel, "msg", "config-reload"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
