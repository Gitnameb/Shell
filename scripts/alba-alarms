#!/usr/bin/env python3
"""Demonio de alarmas de ALBA.

Lee ~/.config/alba/alarms.conf (una línea «enabled|HH:MM|etiqueta» por alarma)
y, cuando llega la hora, muestra un aviso y reproduce el sonido de alarma.

Si el shell de ALBA está abierto, no hace nada: el propio panel del reloj ya
avisa y no queremos avisos duplicados. Cuando el shell está cerrado no hay
servidor de notificaciones, así que `notify-send` falla y se usa un cuadro de
diálogo visible (KDialog o Zenity).

Opciones (para pruebas):
  --once    evalúa una sola vez y termina
  --force   avisa aunque el shell esté abierto
"""

from __future__ import annotations

import datetime
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

POLL_SECONDS = 20
SOUND = "/usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga"


def config_dir() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME", "")
    if not base:
        base = str(Path.home() / ".config")
    return Path(base) / "alba"


def alarms_path() -> Path:
    override = os.environ.get("ALBA_ALARMS_FILE", "")
    if override:
        return Path(override)
    return config_dir() / "alarms.conf"


def timer_path() -> Path:
    override = os.environ.get("ALBA_TIMER_FILE", "")
    if override:
        return Path(override)
    return config_dir() / "timer.conf"


def load_alarms(path: Path) -> list[tuple[str, str]]:
    alarms: list[tuple[str, str]] = []
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return alarms
    for line in lines:
        parts = line.split("|", 2)
        if len(parts) != 3 or parts[0].strip() != "1":
            continue
        at = parts[1].strip()
        label = parts[2].strip() or "Alarma"
        if len(at) != 5 or at[2] != ":":
            continue
        try:
            hour, minute = int(at[:2]), int(at[3:])
        except ValueError:
            continue
        if not (0 <= hour < 24 and 0 <= minute < 60):
            continue
        alarms.append((at, label))
    return alarms


def shell_running() -> bool:
    try:
        result = subprocess.run(
            ["pgrep", "-x", "qs"], capture_output=True, text=True, timeout=3
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return bool(result.stdout.strip())


def notify(title: str, body: str) -> None:
    try:
        result = subprocess.run(
            ["notify-send", "-a", "ALBA", "-u", "critical",
             "-i", "alarm-clock-elapsed", title, body],
            capture_output=True, text=True, timeout=6,
        )
        if result.returncode == 0:
            return
    except (OSError, subprocess.TimeoutExpired):
        pass

    # Sin servidor de notificaciones: un diálogo que no se puede ignorar.
    for command in (
        ["kdialog", "--title", title, "--msgbox", body],
        ["zenity", "--info", "--title", title, "--text", body],
    ):
        if shutil.which(command[0]):
            try:
                subprocess.Popen(command)
            except OSError:
                continue
            return


def play_sound() -> None:
    for command in (
        ["paplay", SOUND],
        ["canberra-gtk-play", "-f", "alarm-clock-elapsed"],
    ):
        if shutil.which(command[0]):
            try:
                subprocess.Popen(command)
            except OSError:
                continue
            return


def due(alarms: list[tuple[str, str]], stamp: str) -> list[tuple[str, str]]:
    return [alarm for alarm in alarms if alarm[0] == stamp]


def timer_deadline(path: Path) -> int:
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return 0
    for line in lines:
        if not line.startswith("deadline="):
            continue
        try:
            return int(line.split("=", 1)[1].strip())
        except ValueError:
            return 0
    return 0


def fire_timer(path: Path) -> None:
    # Renombrar es atómico: si el shell también intenta atenderlo, solo uno
    # de los dos se queda el archivo y avisa.
    claimed = path.with_name(path.name + ".fired")
    try:
        os.replace(path, claimed)
    except OSError:
        return
    notify("Temporizador", "Tiempo cumplido")
    play_sound()
    try:
        claimed.unlink()
    except OSError:
        pass


def run(once: bool, force: bool) -> int:
    fired: set[tuple[str, str, str]] = set()
    while True:
        now = datetime.datetime.now()
        stamp = now.strftime("%H:%M")
        today = now.strftime("%Y-%m-%d")

        if force or not shell_running():
            for at, label in due(load_alarms(alarms_path()), stamp):
                key = (today, at, label)
                if key in fired:
                    continue
                fired.add(key)
                notify("Alarma", f"{label} · {at}")
                play_sound()

            deadline = timer_deadline(timer_path())
            if deadline > 0 and deadline <= int(time.time()):
                fire_timer(timer_path())

        # Solo hace falta recordar lo disparado durante el día actual.
        fired = {key for key in fired if key[0] == today}

        if once:
            return 0
        time.sleep(POLL_SECONDS)


def main() -> int:
    once = "--once" in sys.argv[1:]
    force = "--force" in sys.argv[1:]
    try:
        return run(once, force)
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
