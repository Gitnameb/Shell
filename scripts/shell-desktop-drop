#!/usr/bin/env python3
"""Mueve o copia archivos soltados sobre el escritorio del shell.

Uso: shell-desktop-drop <ruta>...

Los archivos que vienen del mismo sistema de archivos que ~/Desktop se mueven,
como al arrastrarlos al escritorio de Windows; los de otro dispositivo se
copian. Si el nombre ya existe, se añade « (1)», « (2)»… sin sobrescribir nada.
"""

from __future__ import annotations

import shutil
import sys
from pathlib import Path


def free_name(desktop: Path, name: str, is_dir: bool) -> Path:
    target = desktop / name
    if not target.exists():
        return target
    if is_dir:
        stem, suffix = name, ""
    else:
        source = Path(name)
        stem, suffix = (source.stem or name), source.suffix
    index = 1
    while True:
        candidate = desktop / f"{stem} ({index}){suffix}"
        if not candidate.exists():
            return candidate
        index += 1


def main() -> int:
    desktop = Path.home() / "Desktop"
    desktop.mkdir(parents=True, exist_ok=True)
    desktop_device = desktop.stat().st_dev

    for raw in sys.argv[1:]:
        source = Path(raw)
        if not source.exists() or source.parent == desktop:
            continue
        target = free_name(desktop, source.name, source.is_dir())
        try:
            if source.stat().st_dev == desktop_device:
                shutil.move(str(source), str(target))
            elif source.is_dir():
                shutil.copytree(source, target, symlinks=True)
            else:
                shutil.copy2(source, target, follow_symlinks=False)
        except OSError:
            continue
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
