#!/bin/sh
# Devuelve al portapapeles una entrada del historial de cliphist.
#
# Uso: shell-clipboard-copy <id>
set -eu

id="${1:-}"
case "$id" in
    '' | *[!0-9]*) exit 2 ;;
esac

cliphist_bin=$(command -v cliphist 2>/dev/null || true)
if [ -z "$cliphist_bin" ] && [ -x "$HOME/.local/bin/cliphist" ]; then
    cliphist_bin="$HOME/.local/bin/cliphist"
fi
[ -n "$cliphist_bin" ] || exit 1
command -v wl-copy >/dev/null 2>&1 || exit 1

# wl-copy reconoce el tipo a partir del contenido que recibe.
"$cliphist_bin" decode "$id" | wl-copy
