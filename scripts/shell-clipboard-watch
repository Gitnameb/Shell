#!/bin/sh
# Vigilante único del portapapeles. Delega el almacenamiento en cliphist:
# `wl-paste` avisa de cada cambio y `cliphist store` guarda texto e imágenes.
set -u

dir="${XDG_STATE_HOME:-$HOME/.local/state}/shell"
mkdir -p "$dir"

if command -v flock >/dev/null 2>&1; then
    exec 9>"$dir/clipboard-watch.lock"
    flock -n 9 || exit 0
fi

cliphist_bin=$(command -v cliphist 2>/dev/null || true)
if [ -z "$cliphist_bin" ] && [ -x "$HOME/.local/bin/cliphist" ]; then
    cliphist_bin="$HOME/.local/bin/cliphist"
fi
[ -n "$cliphist_bin" ] || exit 0
command -v wl-paste >/dev/null 2>&1 || exit 0

exec wl-paste --watch "$cliphist_bin" store
