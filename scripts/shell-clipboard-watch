#!/bin/sh
# Vigilante único del portapapeles. Si ya hay otro proceso escuchando, sale
# sin error para que Quickshell no acumule instancias al recargar.
set -u

dir="${XDG_STATE_HOME:-$HOME/.local/state}/shell"
mkdir -p "$dir"

if command -v flock >/dev/null 2>&1; then
    exec 9>"$dir/clipboard-watch.lock"
    flock -n 9 || exit 0
fi

# El primer aviso de wl-paste trae lo que ya estuviera copiado. Se marca para
# que shell-clipboard-add lo ignore y el historial empiece con copias nuevas.
: > "$dir/clipboard-first"

base=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# wl-clipboard lo instala el instalador; no hay binarios empaquetados.
command -v wl-paste >/dev/null 2>&1 || exit 0

exec wl-paste --no-newline --watch \
    python3 "$base/shell-clipboard-add"
