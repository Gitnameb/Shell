#!/bin/sh
# Ayudante de DNS privado para el shell. Se instala como root y se ejecuta
# mediante sudo -n desde scripts/network-settings.py.
#
# Uso:
#   shell-private-dns setup
#   shell-private-dns apply <yes|opportunistic> <entrada...>
#   shell-private-dns off
#
# Una entrada es una dirección IP o «IP#nombre», donde el nombre es el que se
# valida en el certificado TLS de DNS over TLS. El ayudante solo escribe la
# configuración de systemd-resolved y reinicia el servicio; no ejecuta nada
# que reciba del usuario.

set -eu

CONF_DIR=/etc/systemd/resolved.conf.d
CONF=$CONF_DIR/90-shell-dns.conf
NM_CONF=/etc/NetworkManager/conf.d/90-shell-dns.conf

fail() {
    printf '%s\n' "$*" >&2
    exit 1
}

valid_entry() {
    entry=$1
    case "$entry" in
        "" | *[!0-9A-Fa-f:.#A-Za-z_-]*) return 1 ;;
    esac
    ip=${entry%%#*}
    host=""
    case "$entry" in
        *'#'*) host=${entry#*#} ;;
    esac
    case "$ip" in
        "" | *[!0-9A-Fa-f:.]*) return 1 ;;
    esac
    if [ -n "$host" ]; then
        case "$host" in
            .* | *. | *..* | *[!A-Za-z0-9.-]*) return 1 ;;
        esac
    fi
    return 0
}

write_conf() {
    tls=$1
    shift
    [ "$tls" = "yes" ] || [ "$tls" = "opportunistic" ] \
        || fail "Modo de TLS no válido."
    for entry in "$@"; do
        valid_entry "$entry" || fail "Entrada DNS no válida: $entry"
    done

    install -d -m755 "$CONF_DIR"
    tmp=$(mktemp "$CONF.XXXXXX")
    {
        printf '[Resolve]\n'
        printf 'DNS='
        first=1
        for entry in "$@"; do
            if [ "$first" -eq 0 ]; then
                printf ' '
            fi
            printf '%s' "$entry"
            first=0
        done
        printf '\n'
        printf 'DNSOverTLS=%s\n' "$tls"
        printf 'DNSSEC=allow-downgrade\n'
        printf 'Cache=yes\n'
        printf 'FallbackDNS=\n'
    } >"$tmp"
    chmod 644 "$tmp"
    mv "$tmp" "$CONF"
}

restart_resolved() {
    systemctl restart systemd-resolved \
        || fail "No se pudo reiniciar systemd-resolved."
}

setup() {
    install -d -m755 "$CONF_DIR" /etc/NetworkManager/conf.d
    restart_nm=0
    if [ ! -f "$NM_CONF" ] \
            || ! grep -q '^dns=systemd-resolved$' "$NM_CONF"; then
        printf '[main]\ndns=systemd-resolved\n' >"$NM_CONF"
        chmod 644 "$NM_CONF"
        restart_nm=1
    fi
    systemctl enable systemd-resolved >/dev/null 2>&1 || true
    restart_resolved
    if [ "$restart_nm" -eq 1 ]; then
        systemctl restart NetworkManager \
            || fail "No se pudo reiniciar NetworkManager."
    fi

    # NetworkManager generaba /etc/resolv.conf como archivo normal. Con el
    # plugin de resolved debe apuntar al stub local para no saltarse el cifrado.
    if [ ! -L /etc/resolv.conf ] \
            && grep -q 'Generated by NetworkManager' /etc/resolv.conf 2>/dev/null; then
        cp -a /etc/resolv.conf /etc/resolv.conf.shell-backup
        rm -f /etc/resolv.conf
        ln -s /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
    fi
    printf 'ok\n'
}

action=${1:-}
case "$action" in
    setup)
        setup
        ;;
    apply)
        shift
        [ "$#" -ge 2 ] || fail "Faltan servidores DNS."
        write_conf "$@"
        restart_resolved
        printf 'ok\n'
        ;;
    off)
        rm -f "$CONF"
        restart_resolved
        printf 'ok\n'
        ;;
    *)
        fail "Uso no válido."
        ;;
esac
