#!/bin/sh
# Sincroniza los colores de la barra nativa de Umbriel con el tema del shell.
#
# Uso: shell-umbriel-theme dark|light [#rrggbb]
#
# Umbriel no lee la configuración de Quickshell, así que el shell reescribe las
# tablas [colors], [colors.border] y [colors.title_bar] mediante el escritor
# único y recarga Umbriel en caliente. El resto del archivo queda intacto.

set -eu

mode="$1"
accent="${2:-#b8bec7}"

case "$mode" in
dark | light) ;;
*)
  echo "modo inválido: $mode (usa dark o light)" >&2
  exit 1
  ;;
esac

cfg="${UMBRIEL_CONFIG:-$HOME/.config/umbriel/config.toml}"
[ -f "$cfg" ] || { echo "no existe $cfg" >&2; exit 1; }

config_set="${SHELL_CONFIG_SET:-$HOME/.local/bin/shell-config-set}"
if [ ! -x "$config_set" ]; then
    config_set=$(command -v shell-config-set 2>/dev/null || true)
fi
if [ ! -x "$config_set" ]; then
    here=$(cd "$(dirname "$0")" && pwd)
    for candidate in "$here/shell-config-set" "$here/../install/bin/shell-config-set"; do
        if [ -x "$candidate" ]; then
            config_set=$candidate
            break
        fi
    done
fi
[ -n "$config_set" ] && [ -x "$config_set" ] \
    || { echo "falta shell-config-set" >&2; exit 1; }

blur_conf="${SHELL_GLASS_BLUR_CONF:-$HOME/.config/shell/glass-blur.conf}"

status=$(python3 - "$config_set" "$mode" "$accent" "$blur_conf" <<'PY'
import json
import subprocess
import sys

writer, mode, accent, blur_conf = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
light = mode == "light"


def read_blur_conf(path):
    values = {
        "DARK_BRIGHTNESS": 0.72,
        "DARK_CONTRAST": 0.92,
        "DARK_SATURATION": 1.06,
        "LIGHT_BRIGHTNESS": 1.08,
        "LIGHT_CONTRAST": 0.95,
        "LIGHT_SATURATION": 1.02,
        "BLUR_PASSES": 3,
    }
    try:
        with open(path, encoding="utf-8") as handle:
            for raw in handle:
                line = raw.split("#", 1)[0].strip()
                if "=" not in line:
                    continue
                key, value = line.split("=", 1)
                key = key.strip()
                if key not in values:
                    continue
                try:
                    values[key] = float(value.strip())
                except ValueError:
                    continue
    except OSError:
        pass
    for key in ("DARK_BRIGHTNESS", "DARK_CONTRAST", "DARK_SATURATION",
                "LIGHT_BRIGHTNESS", "LIGHT_CONTRAST", "LIGHT_SATURATION"):
        values[key] = min(2.0, max(0.0, values[key]))
    values["BLUR_PASSES"] = min(8, max(0, int(values["BLUR_PASSES"])))
    return values


blur_settings = read_blur_conf(blur_conf)


def rgb(value):
    value = value.lstrip("#")[:6]
    return tuple(int(value[i:i + 2], 16) / 255 for i in (0, 2, 4))


def adjust(value):
    r, g, b = rgb(value)
    lum = 0.2126 * r + 0.7152 * g + 0.0722 * b
    if light and lum > 0.38:
        amount = min(0.85, (lum - 0.38) / max(0.01, lum))
        r, g, b = (c + (0 - c) * amount for c in (r, g, b))
    elif not light and lum < 0.55:
        amount = min(0.85, (0.55 - lum) / max(0.01, 1 - lum))
        r, g, b = (c + (1 - c) * amount for c in (r, g, b))
    return "#%02x%02x%02x" % (round(r * 255), round(g * 255), round(b * 255))


acc = adjust(accent)

if light:
    colors = {
        "background": "#f4f3f0",
        "text_primary": "#1b1d21",
        "text_muted": "#565d67",
        "accent_primary": acc,
        "accent_secondary": acc,
    }
    border = {
        "focused": acc,
        "unfocused": "#d0d2d6",
        "outer": "#e4e5e8",
    }
    title = {
        "background": "#ecedee",
        "background_unfocused": "#f4f3f0",
        "text": "#1b1d21",
        "text_unfocused": "#565d67",
        "close": "#d9565e",
        "close_glyph": "#ffffff",
        "close_glyph_hover": "#ffffff",
        "maximize": "#8a9099",
        "maximize_glyph": "#ffffff",
        "maximize_glyph_hover": "#ffffff",
        "minimize": "#d9a93c",
        "minimize_glyph": "#ffffff",
        "minimize_glyph_hover": "#ffffff",
    }
else:
    colors = {
        "background": "#141519",
        "text_primary": "#e8eaed",
        "text_muted": "#8a8f98",
        "accent_primary": acc,
        "accent_secondary": acc,
    }
    border = {
        "focused": acc,
        "unfocused": "#2a2d33",
        "outer": "#1a1c20",
    }
    title = {
        "background": "#1a1c20",
        "background_unfocused": "#141519",
        "text": "#e8eaed",
        "text_unfocused": "#8a8f98",
        "close": "#e06c75",
        "close_glyph": "#141519",
        "close_glyph_hover": "#141519",
        "maximize": "#b8bec7",
        "maximize_glyph": "#141519",
        "maximize_glyph_hover": "#141519",
        "minimize": "#f5c96b",
        "minimize_glyph": "#141519",
        "minimize_glyph_hover": "#141519",
    }

if light:
    blur = {
        "brightness": f"{blur_settings['LIGHT_BRIGHTNESS']:.3f}",
        "contrast": f"{blur_settings['LIGHT_CONTRAST']:.3f}",
        "saturation": f"{blur_settings['LIGHT_SATURATION']:.3f}",
        "passes": str(blur_settings["BLUR_PASSES"]),
    }
else:
    blur = {
        "brightness": f"{blur_settings['DARK_BRIGHTNESS']:.3f}",
        "contrast": f"{blur_settings['DARK_CONTRAST']:.3f}",
        "saturation": f"{blur_settings['DARK_SATURATION']:.3f}",
        "passes": str(blur_settings["BLUR_PASSES"]),
    }

args = [writer]
for section, values in (
    ("colors", colors),
    ("colors.border", border),
    ("colors.title_bar", title),
    ("appearance.blur", blur),
):
    args += ["--section", section]
    for key, value in values.items():
        if section == "appearance.blur":
            args.append(f"{key}={value}")
        else:
            args.append(f"{key}={json.dumps(value + 'FF')}")

result = subprocess.run(
    args,
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    text=True,
    check=False,
)
if result.returncode != 0:
    sys.stderr.write(result.stderr)
    raise SystemExit(result.returncode)
print(result.stdout.strip())
PY
) || exit $?

[ "$status" = "unchanged" ] && exit 0

umbriel msg config-reload
