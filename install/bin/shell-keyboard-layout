#!/bin/sh
# Cambia el layout del teclado físico en la configuración de Umbriel.
#
# Umbriel no expone una acción para fijar un layout concreto (solo «siguiente
# layout»), así que se edita [input.keyboard] mediante el escritor único del
# shell y se recarga la configuración en caliente. El resto del archivo queda
# intacto.
#
# Uso: shell-keyboard-layout es

set -eu

layout="$1"
[ -n "$layout" ] || { echo "falta el layout" >&2; exit 1; }

cfg="${UMBRIEL_CONFIG:-$HOME/.config/umbriel/config.toml}"
[ -f "$cfg" ] || { echo "no existe $cfg" >&2; exit 1; }

config_set="${SHELL_CONFIG_SET:-$HOME/.local/bin/shell-config-set}"
if [ ! -x "$config_set" ]; then
    config_set=$(command -v shell-config-set 2>/dev/null || true)
fi
if [ ! -x "$config_set" ]; then
    here=$(cd "$(dirname "$0")" && pwd)
    for candidate in "$here/shell-config-set" "$here/../install/bin/shell-config-set"; do
        if [ -x "$candidate" ]; then
            config_set=$candidate
            break
        fi
    done
fi
[ -n "$config_set" ] && [ -x "$config_set" ] \
    || { echo "falta shell-config-set" >&2; exit 1; }

# json.dumps produce una cadena TOML válida para cualquier layout.
value=$(python3 -c 'import json, sys; print(json.dumps(sys.argv[1], ensure_ascii=False))' "$layout")

status=$("$config_set" --section input.keyboard "layout=$value") || exit $?
[ "$status" = "unchanged" ] && exit 0

umbriel msg config-reload
