#!/bin/sh
# Bloquea la sesión.
#
# Usa hyprlock con una configuración mínima si todavía no existe. Es el único
# bloqueador del shell: el menú de energía, Mod+Shift+L y shell-idle pasan
# todos por aquí. No necesita sudo.

set -eu

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
config="$config_dir/hyprlock.conf"

if [ ! -f "$config" ]; then
    mkdir -p "$config_dir"
    cat >"$config" <<'EOF'
background {
    monitor =
    color = rgb(12, 14, 18)
}

label {
    monitor =
    text = $TIME
    color = rgb(240, 244, 250)
    font_size = 56
    position = 0, -60
    halign = center
    valign = center
}

label {
    monitor =
    text = Sesión bloqueada
    color = rgb(150, 160, 175)
    font_size = 16
    position = 0, 10
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 240, 44
    outline_thickness = 2
    dots_size = 0.22
    dots_spacing = 0.4
    dots_center = true
    outer_color = rgb(138, 180, 248)
    inner_color = rgb(22, 26, 32)
    font_color = rgb(240, 244, 250)
    placeholder_text = Contraseña
    position = 0, 80
    halign = center
    valign = center
}
EOF
fi

if ! command -v hyprlock >/dev/null 2>&1; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a Shell "Bloqueo" \
            "Falta hyprlock, el bloqueador del shell." || true
    fi
    exit 1
fi

exec hyprlock
