#!/usr/bin/env python3
"""Escritor único de ~/.config/umbriel/config.toml.

Aplica pares clave=valor a secciones concretas, conserva comentarios, orden y
claves desconocidas, serializa con el mismo cerrojo que el resto del shell,
valida el resultado y nunca deja el archivo a medio escribir.

Uso:
    shell-config-set --section display brightness=0.900 extra_dim=0.000
    shell-config-set --section input.keyboard layout='"es"'
    shell-config-set --section colors --section colors.border ...
    shell-config-set --append-block reglas.toml
    shell-config-set --drop-block '# inicio' '# fin' --append-block reglas.toml

Los valores son TOML en crudo: números sin comillas, cadenas entre comillas y
booleanos true/false. `--append-block` añade un bloque literal al final (por
ejemplo, una o varias tablas `[[layer_rule]]`); `--drop-block` borra el tramo
entre dos líneas marcadoras antes de aplicar el resto. La salida es `changed` o
`unchanged`.

Variables:
    UMBRIEL_CONFIG   ruta alternativa de config.toml
    XDG_STATE_HOME   base del registro de cambios
"""

from __future__ import annotations

import fcntl
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import tomllib
from pathlib import Path
from typing import NoReturn

SECTION_RE = re.compile(r"^[ \t]*\[([^\[\]]+)\][ \t]*(?:#.*)?$")
ARRAY_RE = re.compile(r"^[ \t]*\[\[([^\[\]]+)\]\][ \t]*(?:#.*)?$")
KEY_RE = re.compile(r"^([ \t]*)([A-Za-z0-9_-]+)([ \t]*=[ \t]*)(.*)$")
SECTION_NAME_RE = re.compile(r"^[A-Za-z0-9_.-]+$")
KEY_NAME_RE = re.compile(r"^[A-Za-z0-9_-]+$")


def die(message: str) -> NoReturn:
    print(f"shell-config-set: {message}", file=sys.stderr)
    raise SystemExit(1)


def parse_args(
    argv: list[str],
) -> tuple[
    list[tuple[str, list[tuple[str, str]]]],
    list[tuple[str, str]],
    list[str],
]:
    patches: list[tuple[str, list[tuple[str, str]]]] = []
    drops: list[tuple[str, str]] = []
    blocks: list[str] = []
    current: tuple[str, list[tuple[str, str]]] | None = None
    i = 0

    while i < len(argv):
        arg = argv[i]
        if arg in ("-h", "--help"):
            print(__doc__.strip())
            raise SystemExit(0)
        if arg == "--section":
            i += 1
            if i >= len(argv):
                die("falta el nombre de la sección después de --section")
            section = argv[i]
            if not SECTION_NAME_RE.match(section):
                die(f"sección inválida: {section}")
            current = (section, [])
            patches.append(current)
        elif arg == "--drop-block":
            if i + 2 >= len(argv):
                die("--drop-block necesita las dos líneas marcadoras")
            begin, end = argv[i + 1], argv[i + 2]
            if not begin or not end or begin == end:
                die("marcadores de --drop-block inválidos")
            drops.append((begin, end))
            i += 2
        elif arg == "--append-block":
            i += 1
            if i >= len(argv):
                die("falta la ruta del bloque después de --append-block")
            try:
                blocks.append(Path(argv[i]).read_text(encoding="utf-8"))
            except OSError as exc:
                die(f"no se pudo leer el bloque {argv[i]}: {exc}")
        elif arg.startswith("--"):
            die(f"opción desconocida: {arg}")
        else:
            if current is None:
                die(f"clave fuera de una sección: {arg}")
            if "=" not in arg:
                die(f"se esperaba clave=valor: {arg}")
            key, value = arg.split("=", 1)
            if not KEY_NAME_RE.match(key):
                die(f"clave inválida: {key}")
            if not value or "\n" in value or "\r" in value:
                die(f"valor inválido para {key}")
            try:
                tomllib.loads(f"[{current[0]}]\n{key} = {value}\n")
            except tomllib.TOMLDecodeError as exc:
                die(f"valor TOML inválido para {key}: {exc}")
            current[1].append((key, value))
        i += 1

    if not blocks and not drops and not any(items for _, items in patches):
        die("no hay cambios que aplicar")
    return patches, drops, blocks


def find_section(lines: list[str], section: str) -> int | None:
    for index, line in enumerate(lines):
        match = SECTION_RE.match(line)
        if match and match.group(1).strip() == section:
            return index
    return None


def apply_patch(
    text: str,
    patches: list[tuple[str, list[tuple[str, str]]]],
    drops: list[tuple[str, str]] | None = None,
    blocks: list[str] | None = None,
) -> tuple[str, bool]:
    body = text.rstrip("\n")
    lines = body.split("\n") if body else []

    # Los bloques gestionados se sustituyen enteros: se borra el tramo entre
    # las dos líneas marcadoras y, si se pide, se añade la versión nueva. El
    # bucle también limpia duplicados antiguos.
    for begin_marker, end_marker in drops or []:
        removed = False
        while True:
            begin = None
            end = None
            for index, line in enumerate(lines):
                stripped = line.strip()
                if begin is None:
                    if stripped == begin_marker:
                        begin = index
                elif stripped == end_marker:
                    end = index
                    break

            if begin is None:
                break
            if end is None:
                die(f"no se encontró el final del bloque: {end_marker}")
            del lines[begin:end + 1]
            removed = True

        if removed:
            while lines and not lines[-1].strip():
                lines.pop()

    for section, items in patches:
        if not items:
            continue

        header = find_section(lines, section)
        if header is None:
            # Las tablas de arrays ([[layer_rule]]) van al final para que un
            # `[seccion]` nuevo no quede dentro de la última regla.
            insert_at = len(lines)
            for index, line in enumerate(lines):
                if ARRAY_RE.match(line):
                    insert_at = index
                    break
            new_lines: list[str] = []
            if insert_at > 0 and lines[insert_at - 1].strip():
                new_lines.append("")
            new_lines.append(f"[{section}]")
            for key, value in items:
                new_lines.append(f"{key} = {value}")
            if insert_at < len(lines):
                new_lines.append("")
            lines[insert_at:insert_at] = new_lines
            continue

        end = len(lines)
        for index in range(header + 1, len(lines)):
            if SECTION_RE.match(lines[index]) or ARRAY_RE.match(lines[index]):
                end = index
                break

        missing: list[tuple[str, str]] = []
        for key, value in items:
            found = None
            for index in range(header + 1, end):
                match = KEY_RE.match(lines[index])
                if match and match.group(2) == key:
                    found = index
                    break

            if found is None:
                missing.append((key, value))
            else:
                indent = KEY_RE.match(lines[found]).group(1)
                new_line = f"{indent}{key} = {value}"
                if lines[found] != new_line:
                    lines[found] = new_line

        if missing:
            insert_at = end
            while insert_at > header + 1 and not lines[insert_at - 1].strip():
                insert_at -= 1
            for key, value in missing:
                lines.insert(insert_at, f"{key} = {value}")
                insert_at += 1

    for block in blocks or []:
        block_body = block.strip("\n")
        if not block_body:
            continue
        if block_body in "\n".join(lines):
            continue
        if lines and lines[-1].strip():
            lines.append("")
        lines.extend(block_body.split("\n"))

    new_text = "\n".join(lines) + "\n"
    return new_text, new_text != text


def validate_toml(text: str) -> None:
    try:
        tomllib.loads(text)
    except tomllib.TOMLDecodeError as exc:
        die(f"el resultado no es TOML válido: {exc}")


def validate_with_umbriel(path: Path) -> None:
    umbriel = shutil.which("umbriel") or "/usr/bin/umbriel"
    if not (os.path.isfile(umbriel) and os.access(umbriel, os.X_OK)):
        return

    result = subprocess.run(
        [umbriel, "config", "validate", "-c", str(path)],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        message = (result.stderr or result.stdout).strip()
        die("Umbriel rechazó la configuración"
            + (f": {message}" if message else ""))


def log_change(path: Path,
               patches: list[tuple[str, list[tuple[str, str]]]],
               drops: list[tuple[str, str]] | None = None,
               blocks: list[str] | None = None) -> None:
    state = Path(os.environ.get("XDG_STATE_HOME", "")
                 or (Path.home() / ".local" / "state"))
    log_dir = state / "shell"
    stamp = time.strftime("%Y-%m-%d %H:%M:%S")
    keys = ", ".join(
        f"[{section}] {key}" for section, items in patches for key, _ in items
    )
    if drops:
        mensaje = "bloque reemplazado" if blocks else "bloque eliminado"
        keys = (keys + ", " if keys else "") + mensaje
    elif blocks:
        keys = (keys + ", " if keys else "") + "bloque añadido"
    try:
        log_dir.mkdir(parents=True, exist_ok=True)
        with open(log_dir / "config-writer.log", "a", encoding="utf-8") as handle:
            handle.write(f"{stamp} {path}: {keys}\n")
    except OSError:
        pass


def cleanup_temps(config: Path) -> None:
    """Borra temporales huérfanos de escritores que murieron a mitad.

    Se llama con el cerrojo tomado, así que ningún otro escritor puede estar
    usando un temporal en ese momento.
    """
    for candidate in config.parent.glob(config.name + ".shell-*"):
        if candidate.name == config.name + ".shell-lock":
            continue
        try:
            candidate.unlink()
        except OSError:
            pass


def main() -> int:
    patches, drops, blocks = parse_args(sys.argv[1:])

    config = Path(
        os.environ.get("UMBRIEL_CONFIG", "")
        or (Path.home() / ".config" / "umbriel" / "config.toml")
    )
    if not config.is_file() or config.stat().st_size == 0:
        die(f"no existe o está vacío: {config}")

    lock_path = str(config) + ".shell-lock"
    with open(lock_path, "a", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            cleanup_temps(config)
            original = config.read_text(encoding="utf-8")
            new_text, changed = apply_patch(original, patches, drops, blocks)
            if not changed:
                print("unchanged")
                return 0

            validate_toml(new_text)

            mode = config.stat().st_mode & 0o777
            fd, tmp_name = tempfile.mkstemp(
                prefix=config.name + ".shell-", dir=str(config.parent))
            tmp = Path(tmp_name)
            try:
                with os.fdopen(fd, "w", encoding="utf-8") as handle:
                    handle.write(new_text)
                os.chmod(tmp, mode)
                validate_with_umbriel(tmp)
                os.replace(tmp, config)
            except BaseException:
                try:
                    tmp.unlink()
                except FileNotFoundError:
                    pass
                raise
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)

    log_change(config, patches, drops, blocks)
    print("changed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
