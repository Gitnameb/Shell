#!/bin/sh
# Preset de Steam Link sobre la salida virtual genérica.
#
#   steamlink-mode on      salida 1920x864@60 (20:9), juegos de Steam/Proton y
#                          Big Picture a la salida virtual
#   steamlink-mode off     retira la salida y devuelve la primaria al monitor
#   steamlink-mode toggle  alterna
#   steamlink-mode status  «activa» o «inactiva»
#   steamlink-mode info    detalle (name, mode, preset, physical…)
#   steamlink-mode mode WxH[@R]   cambia la resolución sin salir del modo
#
# El trabajo real lo hace virtual-output; este archivo solo fija el preset.
# Resolución personalizada: STEAMLINK_MODE=2560x1080@60 steamlink-mode on,
# o la clave mode en ~/.config/umbriel/virtual-output.conf.
#
# Atajo: Mod+Shift+F11.
set -eu

self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tool=${VIRTUAL_OUTPUT:-$self_dir/virtual-output}

if [ ! -x "$tool" ]; then
    printf 'steamlink-mode: falta %s (instala el shell con install-user-config.sh)\n' "$tool" >&2
    exit 1
fi

if [ -n "${STEAMLINK_PHYSICAL:-}" ]; then
    set -- "$@" --physical "$STEAMLINK_PHYSICAL"
fi

case "${1:-toggle}" in
    on | toggle)
        if [ -n "${STEAMLINK_MODE:-}" ]; then
            set -- "$@" --mode "$STEAMLINK_MODE"
        fi
        ;;
esac

exec "$tool" "$@" --preset steamlink
